protocol RunBeadCDNAPurificationBatch(selected_sample_count = 1) {
  // Batch execution wrapper: run the independent single-sample purification once per
  // selected sample. Batch reagent preparation tables are handled separately.
  repeat post_amplification_purification in schedule(start = 1, end = selected_sample_count, step = 1) {
    BeadCDNAPurification();
  }
}

protocol BeadCDNAPurification returns (purified_cdna) {
  // Independent protocol input: start with 100 uL amplified-cDNA reaction
  // solution containing residual amplification beads. Bead and cDNA masses
  // are benchmark assumptions carried from the preceding amplification case;
  // they are not measurements reported by the source.
  let amplified_cdna = tube(
    label = "AmplifiedCDNAInput",
    capacity = 250uL,
    load = [
      content(kind = ContentKind.BIO_MOLECULE_OR_VIRUS, type = ContentType.DNA, code = "AMPLIFIED_CDNA", attrs = {state: amplified}):0.1ug,
      content(kind = ContentKind.PARTICULATE, type = ContentType.BEADS, code = "RESIDUAL_STREPTAVIDIN_BEADS", attrs = {bead_property: "magnetic", role: carried_over}):0.4mg,
      content(kind = ContentKind.FORMULATION, type = ContentType.BUFFER, code = "AMPLIFICATION_REACTION_SOLUTION", attrs = { role: reaction_environment }):100uL
    ]
  );
  let amplified_cdna_supernatant = tube(label = "AmplifiedCDNASupernatant", capacity = 1000uL);
  let spri_beads = tube(
    label = "SPRIBeads",
    capacity = 1500uL,
    load = [content(kind = ContentKind.PARTICULATE, type = ContentType.BEADS, code = "SPRI_BEADS", attrs = {bead_property: "magnetic", role: cleanup}):100uL]
  );
  let ethanol_85 = tube(
    label = "Fresh85PercentEthanol",
    capacity = 1000uL,
    load = [content(kind = ContentKind.CHEMICAL, type = ContentType.SOLVENT, code = "ETHANOL_85", attrs = {concentration: "85_percent", role: wash}):400uL]
  );
  let nuclease_free_water = tube(
    label = "NucleaseFreeWater",
    capacity = 500uL,
    load = [content(kind = ContentKind.FORMULATION, type = ContentType.BUFFER, code = "NFW", attrs = {role: elution}):100uL]
  );
  let purified_cdna = tube(label = "PurifiedAmplifiedCDNA", capacity = 250uL);
  let waste = tube(label = "PostAmplificationPurificationWaste", capacity = 5000uL);

  // Source step S1: Gather freshly prepared 85% ethanol and room-temperature
  // SPRI beads. Source requires SPRI beads to equilibrate to room temperature
  // for at least 30 min before use.
  // Source step S2: equilibrate SPRI beads.
  with env(thermal = 25C, duration = 30min) {
    hold(sample = spri_beads);
  }

  // Source step S3: Place amplified cDNA on the high magnet position until
  // clear, about 2 min. Source-defined corrective mix if beads remain in
  // solution after 2-3 min is encoded as a required preventive resuspension:
  // pipette 3x at the bottom of the PCR tube with P200 set to 40 uL. While
  // still on the magnetic rack, transfer 90 uL supernatant containing cDNA into
  // a new 0.2 mL tube. High magnet position is execution-layer mapping.
  // Source step S4: corrective resuspension and magnetic clearance.
  repeat pre_magnet_bead_resuspension_mix in schedule(start = 1, end = 3, step = 1) {
    amplified_cdna << [amplified_cdna:40uL];
  }
  // Source step S3: place on the high magnetic rack.
  with env(field = magnetic_rack) {
    // Source step S4: incubate until clear.
    sep(
      sample = amplified_cdna,
      program = magnetic_program(duration = 2min),
      component_fates = {
        AMPLIFIED_CDNA: { bound: 0%, flowthrough: 100% },
        RESIDUAL_STREPTAVIDIN_BEADS: { bound: 100%, flowthrough: 0% },
        AMPLIFICATION_REACTION_SOLUTION: { bound: 0%, flowthrough: 100% }
      }
    );
    // Source step S5: transfer cleared supernatant.
    amplified_cdna_supernatant << [amplified_cdna.contents[1]:90uL];
    // Old beads and uncollected liquid remain in the original tube for disposal.
  }

  // Source step S6: Vortex SPRI beads until fully mixed, add 72 uL to the
  // amplified cDNA supernatant for a 0.8x SPRI bead cleanup, vortex 5s, then
  // briefly centrifuge. Brief spin-down convention: 3000g for 5s; not
  // represented as sep because no material partition is intended.
  agit(sample = spri_beads, mode = "vortex", duration = 15s);
  // Source step S7: add SPRI beads.
  amplified_cdna_supernatant << [spri_beads:72uL];
  // Source step S8: vortex.
  agit(sample = amplified_cdna_supernatant, mode = "vortex", duration = 5s);
  // Source step S9: brief centrifugation; annotation-only.

  // Source step S10: Incubate for 5 min at room temperature to bind amplified
  // cDNA to SPRI beads.
  with env(thermal = 25C, duration = 5min) {
    hold(sample = amplified_cdna_supernatant);
  }

  // Source step S11: Place tube on high magnet position until clear, about
  // 2 min, then while still on the magnetic rack remove and discard
  // supernatant. The retained bound fraction is the SPRI bead-bound cDNA.
  // Source step S12: wait for magnetic clearance.
  let spri_capture_split = sep(
    sample = amplified_cdna_supernatant,
    program = magnetic_program(duration = 2min),
    // Explicit benchmark assumption: all collected cDNA binds the new SPRI beads.
    component_fates = {
      AMPLIFIED_CDNA: { bound: 100%, flowthrough: 0% },
      SPRI_BEADS: { bound: 100%, flowthrough: 0% },
      AMPLIFICATION_REACTION_SOLUTION: { bound: 0%, flowthrough: 100% }
    },
    // Live material order: cDNA [0], reaction solution [1], new SPRI beads [2].
    transitions = [
      transition(
        subject = amplified_cdna_supernatant.materials[0],
        output = MagneticProgramOutput.BOUND,
        to = MaterialRelation.BEAD_BOUND,
        associated_with = amplified_cdna_supernatant.materials[2]
      )
    ]
  );
  let captured_cdna_beads = spri_capture_split[0];

  // Source step S13: While still on the magnetic rack, wash with 180 uL 85%
  // ethanol, incubate 1 min at room temperature, remove and discard
  // supernatant, and repeat once for 2 total ethanol washes.
  with env(field = magnetic_rack) {
    waste << [spri_capture_split[1]];
    // Source step S17: repeat ethanol washing.
    repeat ethanol_wash_cycle in schedule(start = 1, end = 2, step = 1) {
      // Source step S14: add ethanol.
      captured_cdna_beads << [ethanol_85:180uL];
      // Source step S15: incubate the ethanol wash.
      with env(thermal = 25C, duration = 1min) {
        hold(sample = captured_cdna_beads);
      }
      // Source step S16: remove ethanol supernatant.
      sep(
        sample = captured_cdna_beads,
        program = magnetic_program(),
        component_fates = {
          AMPLIFIED_CDNA: { bound: 100%, flowthrough: 0% },
          SPRI_BEADS: { bound: 100%, flowthrough: 0% },
          ETHANOL_85: { bound: 0%, flowthrough: 100% }
        }
      );
      waste << [captured_cdna_beads.contents[1]];
    }

    // Source step S18: Remove residual ethanol with a P20, then air dry SPRI
    // beads for about 2 min while still on the magnetic rack. Do not over-dry;
    // cracking beads indicate over-drying. Residual ethanol removal is retained
    // in annotation because it is a fine aspiration cleanup, not a separation.
    // Source step S19: air dry on the magnetic rack.
    with env(thermal = 25C, duration = 2min) {
      hold(sample = captured_cdna_beads);
    }
  }

  // Source step S20: Remove tube from magnetic rack, fully resuspend bead
  // pellet with 25 uL nuclease-free water, and incubate for 10 min at 37C in a
  // thermocycler. The source does not define resuspension count or stroke
  // volume; use 80% of 25 uL, 20 uL, for 10 cycles.
  // Source step S21: resuspend for elution.
  captured_cdna_beads << [nuclease_free_water:25uL];
  repeat elution_resuspension_mix in schedule(start = 1, end = 10, step = 1) {
    captured_cdna_beads << [captured_cdna_beads:20uL];
  }
  // Source step S22: incubate the elution.
  with env(thermal = 37C, duration = 10min) {
    hold(sample = captured_cdna_beads);
  }

  // Source step S23: Place tube on the low magnet position until clear,
  // about 2 min. While still on the magnetic rack, transfer 25 uL supernatant
  // containing purified cDNA into a new 0.2 mL tube. Low magnet position is
  // execution-layer mapping.
  with env(field = magnetic_rack) {
    // Source step S24: clear on the low magnet position.
    let final_elution_split = sep(
      sample = captured_cdna_beads,
      program = magnetic_program(duration = 2min),
      // Explicit benchmark assumption: complete release, not a measured recovery.
      component_fates = {
        SPRI_BEADS: { bound: 100%, flowthrough: 0% },
        AMPLIFIED_CDNA: { bound: 0%, flowthrough: 100% },
        NFW: { bound: 0%, flowthrough: 100% }
      },
      // Live material order after washing: SPRI beads [0], bound cDNA [1], water [2].
      transitions = [
        transition(subject = captured_cdna_beads.materials[1],
          output = MagneticProgramOutput.FLOWTHROUGH,
          to = MaterialRelation.FREE)
      ]
    );
    // The spent beads remain in the retained portion for tube disposal.
    // Source step S25: transfer purified cDNA.
    purified_cdna << [final_elution_split[1]:25uL];
  }

  // Source step S26: Store on ice before proceeding. Use an author-defined
  // active 0C handling window of 15 min.
  with env(thermal = 0C, duration = 15min) {
    hold(sample = purified_cdna);
  }

  // Source step S27: purified amplified cDNA may be stored at 4C for
  // up to 48h or at -20C for up to 3 months. This is storage metadata for the
  // returned product, not an active execution hold in this protocol.
  return purified_cdna = purified_cdna;
}

RunBeadCDNAPurificationBatch(selected_sample_count = 1);
