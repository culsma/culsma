protocol PBMCFlowCytometryImmunophenotyping returns (acquisition_result_group) {
  let input_pbmc = tube(
    label = "InputPBMCSuspension",
    capacity = 2mL,
    load = [
      content(
        kind = ContentKind.BIO_CELLULAR,
        type = ContentType.CELL_POPULATION,
        code = "PBMC",
        attrs = { state: suspension, concentration_cells_per_mL: 10000000 }
      ):1mL
    ]
  );

  let staining_buffer = tube(
    label = "FlowStainingBuffer",
    capacity = 100mL,
    load = [content(kind = ContentKind.FORMULATION, type = ContentType.BUFFER, code = "FSB", attrs = { role: wash }):80mL]
  );
  let acquisition_buffer = tube(
    label = "FlowAcquisitionBuffer",
    capacity = 10mL,
    load = [content(kind = ContentKind.FORMULATION, type = ContentType.BUFFER, code = "ACQBUF", attrs = { role: resuspension }):8mL]
  );
  let fc_block = tube(
    label = "HumanFcBlock",
    capacity = 200uL,
    load = [content(kind = ContentKind.BIO_MOLECULE_OR_VIRUS, type = ContentType.PROTEIN, code = "FC_BLOCK", attrs = { role: blocking }):100uL]
  );
  let fixation_buffer = tube(
    label = "FixationBufferDilutedInPBS",
    capacity = 10mL,
    load = [content(kind = ContentKind.CHEMICAL, type = ContentType.SOLVENT, code = "FIX_IN_PBS", attrs = { role: fixative }):5mL]
  );

  // Author-declared stock concentration for all five staining and five isotype
  // antibodies: 5 mg/mL; 80 uL contains nominally 400 ug, and 5 uL contains 25 ug.
  // These attrs document the concentration, not a typed solute-mass ledger.
  // PM #106 tracks concentration-aware accounting; RC8 LoadContent currently
  // adds a mass-derived volume if solute mass is loaded alongside carrier volume.
  let anti_cd45 = tube(label = "AntiCD45", capacity = 100uL, load = [content(kind = ContentKind.BIO_MOLECULE_OR_VIRUS, type = ContentType.PROTEIN, code = "ANTI_CD45", attrs = { role: antibody, stock_concentration_mg_per_mL: 5, nominal_antibody_mass_ug: 400, concentration_basis: antibody_protein, concentration_provenance: author_declared, marker: CD45 }):80uL]);
  let anti_cd3 = tube(label = "AntiCD3", capacity = 100uL, load = [content(kind = ContentKind.BIO_MOLECULE_OR_VIRUS, type = ContentType.PROTEIN, code = "ANTI_CD3", attrs = { role: antibody, stock_concentration_mg_per_mL: 5, nominal_antibody_mass_ug: 400, concentration_basis: antibody_protein, concentration_provenance: author_declared, marker: CD3 }):80uL]);
  let anti_cd4 = tube(label = "AntiCD4", capacity = 100uL, load = [content(kind = ContentKind.BIO_MOLECULE_OR_VIRUS, type = ContentType.PROTEIN, code = "ANTI_CD4", attrs = { role: antibody, stock_concentration_mg_per_mL: 5, nominal_antibody_mass_ug: 400, concentration_basis: antibody_protein, concentration_provenance: author_declared, marker: CD4 }):80uL]);
  let anti_cd8 = tube(label = "AntiCD8", capacity = 100uL, load = [content(kind = ContentKind.BIO_MOLECULE_OR_VIRUS, type = ContentType.PROTEIN, code = "ANTI_CD8", attrs = { role: antibody, stock_concentration_mg_per_mL: 5, nominal_antibody_mass_ug: 400, concentration_basis: antibody_protein, concentration_provenance: author_declared, marker: CD8 }):80uL]);
  let anti_cd19 = tube(label = "AntiCD19", capacity = 100uL, load = [content(kind = ContentKind.BIO_MOLECULE_OR_VIRUS, type = ContentType.PROTEIN, code = "ANTI_CD19", attrs = { role: antibody, stock_concentration_mg_per_mL: 5, nominal_antibody_mass_ug: 400, concentration_basis: antibody_protein, concentration_provenance: author_declared, marker: CD19 }):80uL]);
  let viability_dye = tube(
    label = "ViabilityDye",
    capacity = 100uL,
    load = [content(kind = ContentKind.CHEMICAL, type = ContentType.DYE, code = "VIABILITY_DYE", attrs = { role: stain }):80uL]
  );

  let isotype_cd45 = tube(label = "IsotypeCD45", capacity = 100uL, load = [content(kind = ContentKind.BIO_MOLECULE_OR_VIRUS, type = ContentType.PROTEIN, code = "ISOTYPE_CD45", attrs = { role: antibody, stock_concentration_mg_per_mL: 5, nominal_antibody_mass_ug: 400, concentration_basis: antibody_protein, concentration_provenance: author_declared, control_role: isotype, marker: CD45 }):80uL]);
  let isotype_cd3 = tube(label = "IsotypeCD3", capacity = 100uL, load = [content(kind = ContentKind.BIO_MOLECULE_OR_VIRUS, type = ContentType.PROTEIN, code = "ISOTYPE_CD3", attrs = { role: antibody, stock_concentration_mg_per_mL: 5, nominal_antibody_mass_ug: 400, concentration_basis: antibody_protein, concentration_provenance: author_declared, control_role: isotype, marker: CD3 }):80uL]);
  let isotype_cd4 = tube(label = "IsotypeCD4", capacity = 100uL, load = [content(kind = ContentKind.BIO_MOLECULE_OR_VIRUS, type = ContentType.PROTEIN, code = "ISOTYPE_CD4", attrs = { role: antibody, stock_concentration_mg_per_mL: 5, nominal_antibody_mass_ug: 400, concentration_basis: antibody_protein, concentration_provenance: author_declared, control_role: isotype, marker: CD4 }):80uL]);
  let isotype_cd8 = tube(label = "IsotypeCD8", capacity = 100uL, load = [content(kind = ContentKind.BIO_MOLECULE_OR_VIRUS, type = ContentType.PROTEIN, code = "ISOTYPE_CD8", attrs = { role: antibody, stock_concentration_mg_per_mL: 5, nominal_antibody_mass_ug: 400, concentration_basis: antibody_protein, concentration_provenance: author_declared, control_role: isotype, marker: CD8 }):80uL]);
  let isotype_cd19 = tube(label = "IsotypeCD19", capacity = 100uL, load = [content(kind = ContentKind.BIO_MOLECULE_OR_VIRUS, type = ContentType.PROTEIN, code = "ISOTYPE_CD19", attrs = { role: antibody, stock_concentration_mg_per_mL: 5, nominal_antibody_mass_ug: 400, concentration_basis: antibody_protein, concentration_provenance: author_declared, control_role: isotype, marker: CD19 }):80uL]);

  let selected_panel = markers([CD45, CD3, CD4, CD8, CD19, LiveDead]);

  let full_panel_mix = PrepareFullPanel(
    antibody_1 = anti_cd45,
    antibody_2 = anti_cd3,
    antibody_3 = anti_cd4,
    antibody_4 = anti_cd8,
    antibody_5 = anti_cd19,
    viability_dye = viability_dye
  );
  let isotype_panel_mix = PrepareIsotypePanel(
    isotype_1 = isotype_cd45,
    isotype_2 = isotype_cd3,
    isotype_3 = isotype_cd4,
    isotype_4 = isotype_cd8,
    isotype_5 = isotype_cd19,
    viability_dye = viability_dye
  );
  let single_cd45_tube = tube(label = "SingleCD45Reagent", capacity = 100uL);
  let single_cd45_mix = PrepareSingleAntibodyControl(single_antibody = anti_cd45, staining_buffer = staining_buffer, output_tube = single_cd45_tube);
  let single_cd3_tube = tube(label = "SingleCD3Reagent", capacity = 100uL);
  let single_cd3_mix = PrepareSingleAntibodyControl(single_antibody = anti_cd3, staining_buffer = staining_buffer, output_tube = single_cd3_tube);
  let single_cd4_tube = tube(label = "SingleCD4Reagent", capacity = 100uL);
  let single_cd4_mix = PrepareSingleAntibodyControl(single_antibody = anti_cd4, staining_buffer = staining_buffer, output_tube = single_cd4_tube);
  let single_cd8_tube = tube(label = "SingleCD8Reagent", capacity = 100uL);
  let single_cd8_mix = PrepareSingleAntibodyControl(single_antibody = anti_cd8, staining_buffer = staining_buffer, output_tube = single_cd8_tube);
  let single_cd19_tube = tube(label = "SingleCD19Reagent", capacity = 100uL);
  let single_cd19_mix = PrepareSingleAntibodyControl(single_antibody = anti_cd19, staining_buffer = staining_buffer, output_tube = single_cd19_tube);
  let unstained_reagent = PrepareUnstainedControl(staining_buffer = staining_buffer);

  // Source step S1: assign the experimental sample and seven control roles.
  let acquisition_result_group = RunControlSet(
    input_cell_sample = input_pbmc,
    full_panel_mix = full_panel_mix,
    isotype_panel_mix = isotype_panel_mix,
    single_control_1 = single_cd45_mix,
    single_control_2 = single_cd3_mix,
    single_control_3 = single_cd4_mix,
    single_control_4 = single_cd8_mix,
    single_control_5 = single_cd19_mix,
    unstained_reagent = unstained_reagent,
    staining_buffer = staining_buffer,
    fc_block = fc_block,
    fixation_buffer = fixation_buffer,
    acquisition_buffer = acquisition_buffer,
    panel_definition = selected_panel
  );

  return acquisition_result_group;
}

protocol PrepareFullPanel(
  antibody_1,
  antibody_2,
  antibody_3,
  antibody_4,
  antibody_5,
  viability_dye
) returns (full_panel_mix) {
  // Source step S5: prepare the full antibody and viability staining panel.
  let full_panel_mix = tube(label = "FullAntibodyPanel", capacity = 100uL);
  full_panel_mix << [
    antibody_1:5uL,
    antibody_2:5uL,
    antibody_3:5uL,
    antibody_4:5uL,
    antibody_5:5uL,
    viability_dye:5uL
  ] with constraint(high_precision, low_carryover, dark_protected);
  repeat full_panel_mix_cycle in schedule(start = 1, end = 10, step = 1) {
    full_panel_mix << [full_panel_mix:24uL];
  }
  return full_panel_mix;
}

protocol PrepareIsotypePanel(
  isotype_1,
  isotype_2,
  isotype_3,
  isotype_4,
  isotype_5,
  viability_dye
) returns (isotype_panel_mix) {
  // Source step S6: prepare the isotype, single-antibody, and unstained controls.
  let isotype_panel_mix = tube(label = "IsotypeControlPanel", capacity = 100uL);
  isotype_panel_mix << [
    isotype_1:5uL,
    isotype_2:5uL,
    isotype_3:5uL,
    isotype_4:5uL,
    isotype_5:5uL,
    viability_dye:5uL
  ] with constraint(high_precision, low_carryover, dark_protected);
  repeat isotype_panel_mix_cycle in schedule(start = 1, end = 10, step = 1) {
    isotype_panel_mix << [isotype_panel_mix:24uL];
  }
  return isotype_panel_mix;
}

protocol PrepareSingleAntibodyControl(
  single_antibody,
  staining_buffer,
  output_tube
) returns (single_antibody_mix) {
  let single_antibody_mix = output_tube;
  single_antibody_mix << [single_antibody:5uL, staining_buffer:25uL] with constraint(high_precision, low_carryover, dark_protected);
  repeat single_antibody_mix_cycle in schedule(start = 1, end = 10, step = 1) {
    single_antibody_mix << [single_antibody_mix:24uL];
  }
  return single_antibody_mix;
}

protocol PrepareUnstainedControl(staining_buffer) returns (unstained_reagent) {
  let unstained_reagent = tube(label = "UnstainedControlReagent", capacity = 100uL);
  unstained_reagent << [staining_buffer:30uL];
  return unstained_reagent;
}

protocol RunControlSet(
  input_cell_sample,
  full_panel_mix,
  isotype_panel_mix,
  single_control_1,
  single_control_2,
  single_control_3,
  single_control_4,
  single_control_5,
  unstained_reagent,
  staining_buffer,
  fc_block,
  fixation_buffer,
  acquisition_buffer,
  panel_definition
) returns (acquisition_result_group) {
  let shared_waste = tube(label = "FlowProcessWaste", capacity = 100mL);
  let full_stain_tube = tube(label = "FullyStainedSample", capacity = 5mL);
  let unstained_tube = tube(label = "UnstainedAutofluorescenceControl", capacity = 5mL);
  let isotype_tube = tube(label = "IsotypeControlPanel", capacity = 5mL);
  let single_control_tube_1 = tube(label = "SingleAntibodyControl1", capacity = 5mL);
  let single_control_tube_2 = tube(label = "SingleAntibodyControl2", capacity = 5mL);
  let single_control_tube_3 = tube(label = "SingleAntibodyControl3", capacity = 5mL);
  let single_control_tube_4 = tube(label = "SingleAntibodyControl4", capacity = 5mL);
  let single_control_tube_5 = tube(label = "SingleAntibodyControl5", capacity = 5mL);
  let fully_stained_sample = StainAndFixOneTube(
    input_cell_sample = input_cell_sample,
    staining_reagent = full_panel_mix,
    sample_tube = full_stain_tube,
    staining_profile = 1,
    staining_buffer = staining_buffer,
    fc_block = fc_block,
    fixation_buffer = fixation_buffer,
    acquisition_buffer = acquisition_buffer,
    waste = shared_waste
  );
  let unstained_control = StainAndFixOneTube(
    input_cell_sample = input_cell_sample,
    staining_reagent = unstained_reagent,
    sample_tube = unstained_tube,
    staining_buffer = staining_buffer,
    fc_block = fc_block,
    fixation_buffer = fixation_buffer,
    acquisition_buffer = acquisition_buffer,
    waste = shared_waste
  );
  let isotype_control = StainAndFixOneTube(
    input_cell_sample = input_cell_sample,
    staining_reagent = isotype_panel_mix,
    sample_tube = isotype_tube,
    staining_profile = 2,
    staining_buffer = staining_buffer,
    fc_block = fc_block,
    fixation_buffer = fixation_buffer,
    acquisition_buffer = acquisition_buffer,
    waste = shared_waste
  );
  let single_control_sample_1 = StainAndFixOneTube(input_cell_sample = input_cell_sample, staining_reagent = single_control_1, sample_tube = single_control_tube_1, staining_profile = 3, staining_buffer = staining_buffer, fc_block = fc_block, fixation_buffer = fixation_buffer, acquisition_buffer = acquisition_buffer, waste = shared_waste);
  let single_control_sample_2 = StainAndFixOneTube(input_cell_sample = input_cell_sample, staining_reagent = single_control_2, sample_tube = single_control_tube_2, staining_profile = 4, staining_buffer = staining_buffer, fc_block = fc_block, fixation_buffer = fixation_buffer, acquisition_buffer = acquisition_buffer, waste = shared_waste);
  let single_control_sample_3 = StainAndFixOneTube(input_cell_sample = input_cell_sample, staining_reagent = single_control_3, sample_tube = single_control_tube_3, staining_profile = 5, staining_buffer = staining_buffer, fc_block = fc_block, fixation_buffer = fixation_buffer, acquisition_buffer = acquisition_buffer, waste = shared_waste);
  let single_control_sample_4 = StainAndFixOneTube(input_cell_sample = input_cell_sample, staining_reagent = single_control_4, sample_tube = single_control_tube_4, staining_profile = 6, staining_buffer = staining_buffer, fc_block = fc_block, fixation_buffer = fixation_buffer, acquisition_buffer = acquisition_buffer, waste = shared_waste);
  let single_control_sample_5 = StainAndFixOneTube(input_cell_sample = input_cell_sample, staining_reagent = single_control_5, sample_tube = single_control_tube_5, staining_profile = 7, staining_buffer = staining_buffer, fc_block = fc_block, fixation_buffer = fixation_buffer, acquisition_buffer = acquisition_buffer, waste = shared_waste);

  // Runtime data fields carry textual identifiers across protocol boundaries.
  let acquisition_labels = data_ref(kind = custom);
  acquisition_labels.result.fully_stained = "fully_stained";
  acquisition_labels.result.unstained = "unstained";
  acquisition_labels.result.isotype_panel = "isotype_panel";
  acquisition_labels.result.single_cd45 = "single_cd45";
  acquisition_labels.result.single_cd3 = "single_cd3";
  acquisition_labels.result.single_cd4 = "single_cd4";
  acquisition_labels.result.single_cd8 = "single_cd8";
  acquisition_labels.result.single_cd19 = "single_cd19";
  acquisition_labels.result.experimental_sample = "experimental_sample";
  acquisition_labels.result.autofluorescence_control = "autofluorescence_control";
  acquisition_labels.result.isotype_control = "isotype_control";
  acquisition_labels.result.single_stained_control = "single_stained_control";

  // Source step S11: acquire and return eight separately identified event streams.
  let fully_stained_readout = AcquireOneSample(input_sample = fully_stained_sample, panel_definition = panel_definition, acquisition_sample_id = acquisition_labels.result.fully_stained, acquisition_control_role = acquisition_labels.result.experimental_sample);
  let unstained_readout = AcquireOneSample(input_sample = unstained_control, panel_definition = panel_definition, acquisition_sample_id = acquisition_labels.result.unstained, acquisition_control_role = acquisition_labels.result.autofluorescence_control);
  let isotype_readout = AcquireOneSample(input_sample = isotype_control, panel_definition = panel_definition, acquisition_sample_id = acquisition_labels.result.isotype_panel, acquisition_control_role = acquisition_labels.result.isotype_control);
  let single_readout_1 = AcquireOneSample(input_sample = single_control_sample_1, panel_definition = panel_definition, acquisition_sample_id = acquisition_labels.result.single_cd45, acquisition_control_role = acquisition_labels.result.single_stained_control);
  let single_readout_2 = AcquireOneSample(input_sample = single_control_sample_2, panel_definition = panel_definition, acquisition_sample_id = acquisition_labels.result.single_cd3, acquisition_control_role = acquisition_labels.result.single_stained_control);
  let single_readout_3 = AcquireOneSample(input_sample = single_control_sample_3, panel_definition = panel_definition, acquisition_sample_id = acquisition_labels.result.single_cd4, acquisition_control_role = acquisition_labels.result.single_stained_control);
  let single_readout_4 = AcquireOneSample(input_sample = single_control_sample_4, panel_definition = panel_definition, acquisition_sample_id = acquisition_labels.result.single_cd8, acquisition_control_role = acquisition_labels.result.single_stained_control);
  let single_readout_5 = AcquireOneSample(input_sample = single_control_sample_5, panel_definition = panel_definition, acquisition_sample_id = acquisition_labels.result.single_cd19, acquisition_control_role = acquisition_labels.result.single_stained_control);

  let acquisition_result_group = data_group_ref(kind = flow_cytometry_acquisition);
  acquisition_result_group.items.append(fully_stained_readout);
  acquisition_result_group.items.append(unstained_readout);
  acquisition_result_group.items.append(isotype_readout);
  acquisition_result_group.items.append(single_readout_1);
  acquisition_result_group.items.append(single_readout_2);
  acquisition_result_group.items.append(single_readout_3);
  acquisition_result_group.items.append(single_readout_4);
  acquisition_result_group.items.append(single_readout_5);
  return acquisition_result_group;
}

protocol FirstStainingWash(sample, waste, staining_profile) returns (retained_sample) {
  // Author-declared benchmark fractions, not measured binding yields:
  // antibodies 0.1%, isotypes 0.01%, viability dye 1% retained once.
  // Profiles: 0 unstained, 1 full panel, 2 isotypes, 3-7 single CD45/CD3/CD4/CD8/CD19.
  // Live input order: PBMC[0], FSB[1], FC_BLOCK[2], antibody/ies[3...], dye[8].
  // Isotype cell_bound denotes assumed nonspecific association, not target recognition.
  with env(thermal = 4C, duration = 5min) {
    if staining_profile == 1 {
      let wash_split_1 = sep(
        sample = sample,
        program = centrifuge_program(drive = 300g, keep_source = "pellet"),
        component_fates = {
          ANTI_CD45: { supernatant: 99.9%, pellet: 0.1% },
          ANTI_CD3: { supernatant: 99.9%, pellet: 0.1% },
          ANTI_CD4: { supernatant: 99.9%, pellet: 0.1% },
          ANTI_CD8: { supernatant: 99.9%, pellet: 0.1% },
          ANTI_CD19: { supernatant: 99.9%, pellet: 0.1% },
          VIABILITY_DYE: { supernatant: 99%, pellet: 1% }
        },
        transitions = [
          transition(subject = sample.materials[3], output = CentrifugeProgramOutput.PELLET, to = MaterialRelation.CELL_BOUND, associated_with = sample.materials[0]),
          transition(subject = sample.materials[4], output = CentrifugeProgramOutput.PELLET, to = MaterialRelation.CELL_BOUND, associated_with = sample.materials[0]),
          transition(subject = sample.materials[5], output = CentrifugeProgramOutput.PELLET, to = MaterialRelation.CELL_BOUND, associated_with = sample.materials[0]),
          transition(subject = sample.materials[6], output = CentrifugeProgramOutput.PELLET, to = MaterialRelation.CELL_BOUND, associated_with = sample.materials[0]),
          transition(subject = sample.materials[7], output = CentrifugeProgramOutput.PELLET, to = MaterialRelation.CELL_BOUND, associated_with = sample.materials[0]),
          transition(subject = sample.materials[8], output = CentrifugeProgramOutput.PELLET, to = MaterialRelation.CELL_BOUND, associated_with = sample.materials[0])
        ]
      );
      waste << [wash_split_1[0]] with constraint(gentle);
    }
    if staining_profile == 2 {
      let wash_split_2 = sep(
        sample = sample,
        program = centrifuge_program(drive = 300g, keep_source = "pellet"),
        component_fates = {
          ISOTYPE_CD45: { supernatant: 99.99%, pellet: 0.01% },
          ISOTYPE_CD3: { supernatant: 99.99%, pellet: 0.01% },
          ISOTYPE_CD4: { supernatant: 99.99%, pellet: 0.01% },
          ISOTYPE_CD8: { supernatant: 99.99%, pellet: 0.01% },
          ISOTYPE_CD19: { supernatant: 99.99%, pellet: 0.01% },
          VIABILITY_DYE: { supernatant: 99%, pellet: 1% }
        },
        transitions = [
          transition(subject = sample.materials[3], output = CentrifugeProgramOutput.PELLET, to = MaterialRelation.CELL_BOUND, associated_with = sample.materials[0]),
          transition(subject = sample.materials[4], output = CentrifugeProgramOutput.PELLET, to = MaterialRelation.CELL_BOUND, associated_with = sample.materials[0]),
          transition(subject = sample.materials[5], output = CentrifugeProgramOutput.PELLET, to = MaterialRelation.CELL_BOUND, associated_with = sample.materials[0]),
          transition(subject = sample.materials[6], output = CentrifugeProgramOutput.PELLET, to = MaterialRelation.CELL_BOUND, associated_with = sample.materials[0]),
          transition(subject = sample.materials[7], output = CentrifugeProgramOutput.PELLET, to = MaterialRelation.CELL_BOUND, associated_with = sample.materials[0]),
          transition(subject = sample.materials[8], output = CentrifugeProgramOutput.PELLET, to = MaterialRelation.CELL_BOUND, associated_with = sample.materials[0])
        ]
      );
      waste << [wash_split_2[0]] with constraint(gentle);
    }
    if staining_profile == 3 {
      let wash_split_3 = sep(
        sample = sample,
        program = centrifuge_program(drive = 300g, keep_source = "pellet"),
        component_fates = {
          ANTI_CD45: { supernatant: 99.9%, pellet: 0.1% }
        },
        transitions = [
          transition(subject = sample.materials[3], output = CentrifugeProgramOutput.PELLET, to = MaterialRelation.CELL_BOUND, associated_with = sample.materials[0])
        ]
      );
      waste << [wash_split_3[0]] with constraint(gentle);
    }
    if staining_profile == 4 {
      let wash_split_4 = sep(
        sample = sample,
        program = centrifuge_program(drive = 300g, keep_source = "pellet"),
        component_fates = {
          ANTI_CD3: { supernatant: 99.9%, pellet: 0.1% }
        },
        transitions = [
          transition(subject = sample.materials[3], output = CentrifugeProgramOutput.PELLET, to = MaterialRelation.CELL_BOUND, associated_with = sample.materials[0])
        ]
      );
      waste << [wash_split_4[0]] with constraint(gentle);
    }
    if staining_profile == 5 {
      let wash_split_5 = sep(
        sample = sample,
        program = centrifuge_program(drive = 300g, keep_source = "pellet"),
        component_fates = {
          ANTI_CD4: { supernatant: 99.9%, pellet: 0.1% }
        },
        transitions = [
          transition(subject = sample.materials[3], output = CentrifugeProgramOutput.PELLET, to = MaterialRelation.CELL_BOUND, associated_with = sample.materials[0])
        ]
      );
      waste << [wash_split_5[0]] with constraint(gentle);
    }
    if staining_profile == 6 {
      let wash_split_6 = sep(
        sample = sample,
        program = centrifuge_program(drive = 300g, keep_source = "pellet"),
        component_fates = {
          ANTI_CD8: { supernatant: 99.9%, pellet: 0.1% }
        },
        transitions = [
          transition(subject = sample.materials[3], output = CentrifugeProgramOutput.PELLET, to = MaterialRelation.CELL_BOUND, associated_with = sample.materials[0])
        ]
      );
      waste << [wash_split_6[0]] with constraint(gentle);
    }
    if staining_profile == 7 {
      let wash_split_7 = sep(
        sample = sample,
        program = centrifuge_program(drive = 300g, keep_source = "pellet"),
        component_fates = {
          ANTI_CD19: { supernatant: 99.9%, pellet: 0.1% }
        },
        transitions = [
          transition(subject = sample.materials[3], output = CentrifugeProgramOutput.PELLET, to = MaterialRelation.CELL_BOUND, associated_with = sample.materials[0])
        ]
      );
      waste << [wash_split_7[0]] with constraint(gentle);
    }
    if staining_profile == 0 {
      let plain_wash_split_0 = sep(sample = sample, program = centrifuge_program(drive = 300g, keep_source = "pellet"));
      waste << [plain_wash_split_0[0]] with constraint(gentle);
    }
  }
  return retained_sample = sample;
}

protocol WashRetainedStains(sample, waste, staining_profile) returns (retained_sample) {
  // Retain all previously cell-bound stain; do not reapply initial binding yields.
  with env(thermal = 4C, duration = 5min) {
    if staining_profile == 1 {
      let wash_split_1 = sep(
        sample = sample,
        program = centrifuge_program(drive = 300g, keep_source = "pellet"),
        component_fates = {
          ANTI_CD45: { supernatant: 0%, pellet: 100% },
          ANTI_CD3: { supernatant: 0%, pellet: 100% },
          ANTI_CD4: { supernatant: 0%, pellet: 100% },
          ANTI_CD8: { supernatant: 0%, pellet: 100% },
          ANTI_CD19: { supernatant: 0%, pellet: 100% },
          VIABILITY_DYE: { supernatant: 0%, pellet: 100% }
        }
      );
      waste << [wash_split_1[0]] with constraint(gentle);
    }
    if staining_profile == 2 {
      let wash_split_2 = sep(
        sample = sample,
        program = centrifuge_program(drive = 300g, keep_source = "pellet"),
        component_fates = {
          ISOTYPE_CD45: { supernatant: 0%, pellet: 100% },
          ISOTYPE_CD3: { supernatant: 0%, pellet: 100% },
          ISOTYPE_CD4: { supernatant: 0%, pellet: 100% },
          ISOTYPE_CD8: { supernatant: 0%, pellet: 100% },
          ISOTYPE_CD19: { supernatant: 0%, pellet: 100% },
          VIABILITY_DYE: { supernatant: 0%, pellet: 100% }
        }
      );
      waste << [wash_split_2[0]] with constraint(gentle);
    }
    if staining_profile == 3 {
      let wash_split_3 = sep(
        sample = sample,
        program = centrifuge_program(drive = 300g, keep_source = "pellet"),
        component_fates = {
          ANTI_CD45: { supernatant: 0%, pellet: 100% }
        }
      );
      waste << [wash_split_3[0]] with constraint(gentle);
    }
    if staining_profile == 4 {
      let wash_split_4 = sep(
        sample = sample,
        program = centrifuge_program(drive = 300g, keep_source = "pellet"),
        component_fates = {
          ANTI_CD3: { supernatant: 0%, pellet: 100% }
        }
      );
      waste << [wash_split_4[0]] with constraint(gentle);
    }
    if staining_profile == 5 {
      let wash_split_5 = sep(
        sample = sample,
        program = centrifuge_program(drive = 300g, keep_source = "pellet"),
        component_fates = {
          ANTI_CD4: { supernatant: 0%, pellet: 100% }
        }
      );
      waste << [wash_split_5[0]] with constraint(gentle);
    }
    if staining_profile == 6 {
      let wash_split_6 = sep(
        sample = sample,
        program = centrifuge_program(drive = 300g, keep_source = "pellet"),
        component_fates = {
          ANTI_CD8: { supernatant: 0%, pellet: 100% }
        }
      );
      waste << [wash_split_6[0]] with constraint(gentle);
    }
    if staining_profile == 7 {
      let wash_split_7 = sep(
        sample = sample,
        program = centrifuge_program(drive = 300g, keep_source = "pellet"),
        component_fates = {
          ANTI_CD19: { supernatant: 0%, pellet: 100% }
        }
      );
      waste << [wash_split_7[0]] with constraint(gentle);
    }
    if staining_profile == 0 {
      let plain_wash_split_0 = sep(sample = sample, program = centrifuge_program(drive = 300g, keep_source = "pellet"));
      waste << [plain_wash_split_0[0]] with constraint(gentle);
    }
  }
  return retained_sample = sample;
}

protocol StainAndFixOneTube(
  input_cell_sample,
  staining_reagent,
  sample_tube,
  staining_buffer,
  fc_block,
  fixation_buffer,
  acquisition_buffer,
  waste,
  staining_profile = 0
) returns (acquisition_sample) {
  // Source step S2: aliquot the PBMC suspension into the assigned tube.
  sample_tube << [input_cell_sample:100uL] with constraint(high_precision, low_carryover);

  sample_tube << [staining_buffer:2mL];
  // Source step S3: wash the tube and retain the cell pellet.
  with env(thermal = 4C, duration = 5min) {
    let initial_wash_split = sep(sample = sample_tube, program = centrifuge_program(drive = 300g, keep_source = "pellet"));
    waste << [initial_wash_split[0]] with constraint(gentle);
  }
  let initial_cell_pellet = sample_tube;

  // Source step S4: resuspend, block Fc receptors, mix, and incubate on ice.
  initial_cell_pellet << [staining_buffer:65uL];
  repeat initial_resuspension in schedule(start = 1, end = 10, step = 1) {
    initial_cell_pellet << [initial_cell_pellet:52uL];
  }
  initial_cell_pellet << [fc_block:5uL] with constraint(high_precision, low_carryover);
  repeat fc_block_mix in schedule(start = 1, end = 10, step = 1) {
    initial_cell_pellet << [initial_cell_pellet:56uL];
  }
  with env(thermal = 0C, duration = 10min) {
    hold(sample = initial_cell_pellet);
  }

  // Source step S7: stain the assigned tube and incubate on ice under dark protection.
  initial_cell_pellet << [staining_reagent:30uL] with constraint(high_precision, low_carryover, dark_protected);
  repeat staining_mix in schedule(start = 1, end = 10, step = 1) {
    initial_cell_pellet << [initial_cell_pellet:80uL];
  }
  with constraint(dark_protected) {
    with env(thermal = 0C, duration = 30min) {
      hold(sample = initial_cell_pellet);
    }
  }

  initial_cell_pellet << [staining_buffer:2mL];
  // Source step S8: wash twice and retain the cell pellet after each separation.
  let wash1_cell_pellet = FirstStainingWash(sample = initial_cell_pellet, waste = waste, staining_profile = staining_profile);

  wash1_cell_pellet << [staining_buffer:2mL];
  repeat wash2_resuspension in schedule(start = 1, end = 10, step = 1) {
    wash1_cell_pellet << [wash1_cell_pellet:1.6mL];
  }
  let stained_cell_pellet = WashRetainedStains(sample = wash1_cell_pellet, waste = waste, staining_profile = staining_profile);

  // Source step S9: fix the retained cell pellet under dark protection.
  stained_cell_pellet << [fixation_buffer:300uL];
  repeat fixation_resuspension in schedule(start = 1, end = 10, step = 1) {
    stained_cell_pellet << [stained_cell_pellet:240uL];
  }
  with constraint(dark_protected) {
    with env(thermal = 25C, duration = 10min) {
      hold(sample = stained_cell_pellet);
    }
  }

  stained_cell_pellet << [staining_buffer:2mL];
  // Source step S10: wash fixed cells, resuspend in acquisition buffer, and hold cold.
  let acquisition_sample = WashRetainedStains(sample = stained_cell_pellet, waste = waste, staining_profile = staining_profile);
  acquisition_sample << [acquisition_buffer:500uL];
  repeat acquisition_resuspension in schedule(start = 1, end = 10, step = 1) {
    acquisition_sample << [acquisition_sample:400uL];
  }
  with constraint(dark_protected) {
    with env(thermal = 4C, duration = 30min) {
      hold(sample = acquisition_sample);
    }
  }

  return acquisition_sample;
}

protocol AcquireOneSample(
  input_sample,
  panel_definition,
  acquisition_sample_id,
  acquisition_control_role
) returns (acquisition_readout) {
  let event_stream = stream(
    sample = input_sample,
    unit = single_cell,
    panel = panel_definition
  );
  let acquisition_schema = data_schema(
    label = "FlowCytometryAcquisition",
    fields = [
      event_id,
      sample_id,
      control_role,
      fsc_a,
      fsc_h,
      ssc_a,
      cd45_raw_signal,
      cd3_raw_signal,
      cd4_raw_signal,
      cd8_raw_signal,
      cd19_raw_signal,
      viability_raw_signal,
      acquisition_config_id,
      acquisition_qc_pass
    ]
  );
  let acquisition_readout = img(
    sample = event_stream,
    quantity = customized,
    schema_ref = acquisition_schema,
    save_raw = true
  );
  acquisition_readout.result.sample_id = acquisition_sample_id;
  acquisition_readout.result.control_role = acquisition_control_role;
  return acquisition_readout;
}

PBMCFlowCytometryImmunophenotyping();
