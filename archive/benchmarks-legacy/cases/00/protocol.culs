protocol GfpLysateClarification(
  cell_suspension_volume = 80uL,
  cell_count = 100000cells,
  lysis_buffer_volume = 80uL,
  clarified_volume = 100uL
) {
  // Source step S1: Prepare 100000 washed GFP-expressing microbial cells in 80 uL lysis-compatible
  //   resuspension buffer.
  let cell_suspension = tube(
    label = "GfpCellSuspension",
    capacity = 1.5mL,
    load = [
      content(
        kind = ContentKind.BIO_CELLULAR,
        type = ContentType.MICROBIAL_CELLS,
        code = "GFP_EXPRESSING_MICROBIAL_CELLS",
        attrs = { state: suspension, carrier: "lysis_compatible_resuspension_buffer" }
      ):cell_count,
      content(
        kind = ContentKind.FORMULATION,
        type = ContentType.BUFFER,
        code = "LYSIS_COMPATIBLE_RESUSPENSION_BUFFER"
      ):cell_suspension_volume
    ]
  );

  // Source step S2: Prepare at least 80 uL 2x lysis buffer.
  let lysis_buffer_2x = tube(
    label = "LysisBuffer2x",
    capacity = 1.5mL,
    load = [
      content(
        kind = ContentKind.FORMULATION,
        type = ContentType.BUFFER,
        code = "LYSIS_BUFFER_2X",
        attrs = { role: lysis }
      ):lysis_buffer_volume
    ]
  );

  // Source step S3: Prepare one 1.5 mL lysis tube.
  let lysis_tube = tube(label = "LysisTube", capacity = 1.5mL);
  // Source step S4: Prepare one 1.0 mL clarified-lysate output tube.
  let clarified_lysate = tube(label = "ClarifiedLysate", capacity = 1mL);
  // Source step S5: Prepare one 1.0 mL debris-waste tube.
  let debris_waste = tube(label = "DebrisWaste", capacity = 1mL);

  // Source step S6: Transfer 80 uL washed GFP-expressing microbial-cell suspension containing 100000 cells and
  //   80 uL 2x lysis buffer into the 1.5 mL lysis tube to produce a 1x final lysis condition.
  lysis_tube << [
    cell_suspension:cell_suspension_volume,
    lysis_buffer_2x:lysis_buffer_volume
  ];

  // Source step S7: Mix the lysis mixture by pipetting 10 times.
  repeat lysis_pipette_mix in schedule(start = 1, end = 10, step = 1) {
    lysis_tube << [lysis_tube:128uL];
  }

  // Source step S8: Incubate the lysis mixture at 37 C for 30 min.
  with env(thermal = 37C, duration = 30min) {
    hold(sample = lysis_tube);
  }

  // Source step S9: Centrifuge the lysate at 12000 x g and 22 C for 10 min to resolve a clarified supernatant
  //   fraction and a debris-pellet fraction.
  with env(thermal = 22C, duration = 10min) {
    sep(
      sample = lysis_tube,
      program = centrifuge_program(drive = 12000g)
    );
  }
  // Source step S10: Transfer 100 uL clarified supernatant fraction to the clarified-lysate output tube.
  clarified_lysate << [lysis_tube.contents[0]:clarified_volume];
  // Source step S11: Discard the debris-pellet fraction.
  debris_waste << [lysis_tube.contents[1]];

  // Source step S12: Record a fluorescence readout from the clarified lysate.
  let lysate_readout = img(
    sample = clarified_lysate,
    quantity = fluorescence,
    save_raw = true
  );
}

GfpLysateClarification();
