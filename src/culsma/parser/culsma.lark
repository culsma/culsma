// ============================================================
// Culsma grammar v0.1 — Lark format
// Translated from grammar_v0.1.ebnf
// ============================================================
//
// Conventions:
//   - Rules (lowercase): define language structure
//   - Terminals (UPPERCASE): define tokens (lexer)
//   - ? prefix: inline rule if it has a single child (no wrapper node)
//   - -> alias: name the tree node for the transformer
//   - String literals ("protocol") have higher priority than regex terminals
// ============================================================


// ------------------------------------------------------------
// 1. Top-level structure
// ------------------------------------------------------------

start: pre_protocol_decl* top_level_item*

?pre_protocol_decl: source_include_decl
    | library_import_decl

?top_level_item: protocol_decl
    | statement

source_include_decl: "include" STRING ";" -> source_include_decl
library_import_decl: "import" IDENTIFIER ";" -> library_import_decl

protocol_decl: "protocol" IDENTIFIER ("(" param_decl_list? ")")? returns_decl? "{" statement* "}"
param_decl_list: param_decl ("," param_decl)*
param_decl: IDENTIFIER ("=" expression)?
returns_decl: "returns" "(" return_name_list? ")" -> returns_decl
return_name_list: IDENTIFIER ("," IDENTIFIER)*


// ------------------------------------------------------------
// 2. Statements
// ------------------------------------------------------------
// Three kinds: include, let, step call.
// Each terminated by ";".

statement: constrained_simple_statement ";"
    | include_statement ";"
    | call_statement ";"
    | let_statement ";"
    | return_statement ";"
    | assign_statement ";"
    | with_env_stmt
    | with_constraint_stmt
    | mutation_stmt ";"
    | step_call ";"
    | break_statement ";"
    | continue_statement ";"
    | repeat_statement
    | if_statement

constrained_simple_statement: simple_statement "with" "constraint" "(" constraint_item_block ")" -> constrained_simple_statement
?simple_statement: include_statement
    | call_statement
    | let_statement
    | return_statement
    | assign_statement
    | mutation_stmt
    | step_call
    | break_statement
    | continue_statement

include_statement: "include" IDENTIFIER -> include_stmt

let_statement: "let" IDENTIFIER "=" let_rhs
?let_rhs: expression
return_statement: "return" named_return_binding_list -> named_return_statement
    | "return" expression -> return_statement
named_return_binding_list: named_return_binding ("," named_return_binding)*
named_return_binding: IDENTIFIER "=" expression -> named_return_binding
assign_statement.1: IDENTIFIER "=" expression -> assign_identifier_statement
    | ref_expr "." IDENTIFIER "=" expression -> assign_member_statement
call_statement.2: ref_expr "." IDENTIFIER "(" call_statement_arg_list? ")" -> call_statement
call_statement_arg_list: call_statement_arg ("," call_statement_arg)*
?call_statement_arg: arg | expression

step_call: IDENTIFIER "(" step_arg_list? ")"
step_arg_list: step_arg ("," step_arg)*
?step_arg: arg | expression
with_env_stmt: "with" "env" "(" env_arg_block ")" "{" statement* "}"
with_constraint_stmt: "with" "constraint" "(" constraint_item_block ")" "{" statement* "}"
env_arg_block: arg_list?
constraint_item_block: constraint_item_list?
constraint_item_list: constraint_item ("," constraint_item)*
?constraint_item: IDENTIFIER -> constraint_name
    | arg

mutation_stmt: batch_target_expr MUTATE_OP mutation_source_list
mutation_source_list: "[" mutation_source_item ("," mutation_source_item)* "]"
?mutation_source_item: mutation_pair_expr
    | source_partition_expr
    | ref_expr
    | mutation_series_expr
mutation_series_expr: "series" "(" ref_expr "," list_literal ")" -> mutation_series_expr
source_partition_expr: ref_expr "." "partition" "(" expression ")" "[" expression "]" -> source_partition_expr

break_statement: "break" -> break_stmt
continue_statement: "continue" -> continue_stmt

repeat_statement: "repeat" repeat_header "{" statement* "}"
repeat_header: IDENTIFIER "in" expression -> repeat_binding_header
    | expression -> repeat_times_header

if_statement: "if" expression "{" statement* "}" else_clause?
else_clause: "else" "{" statement* "}"

arg_list: arg ("," arg)*

arg: IDENTIFIER "=" expression


// ------------------------------------------------------------
// 3. Expressions — precedence climbing via left-recursive rules
// ------------------------------------------------------------
// Precedence (low to high):
//   or  <  and  <  comparison  <  add/sub  <  mul/div  <  unary  <  primary
//
// ? prefix inlines single-child rules so the AST stays flat.
// -> aliases name each operator variant for the transformer.

?expression: or_expr

?or_expr: and_expr
    | or_expr "or" and_expr -> or_op

?and_expr: compare_expr
    | and_expr "and" compare_expr -> and_op

?compare_expr: add_expr
    | add_expr COMPARE_OP add_expr -> comparison

?add_expr: mul_expr
    | add_expr "+" mul_expr -> add_op
    | add_expr "-" mul_expr -> sub_op

?mul_expr: unary_expr
    | mul_expr "*" unary_expr -> mul_op
    | mul_expr "/" unary_expr -> div_op

?unary_expr: primary_expr
    | "-" primary_expr -> neg_op

?primary_expr: atom_expr

?atom_expr: QUANTITY -> quantity
    | STRING -> string_literal
    | BOOLEAN -> boolean_literal
    | markers_expr
    | call_expr
    | group_expr
    | source_partition_expr
    | method_call_expr
    | ref_expr
    | list_literal
    | record_literal
    | "(" expression ")"

markers_expr: "markers" "(" list_literal ")" -> markers_expr
call_expr: IDENTIFIER "(" arg_list? ")" -> call_expr
method_call_arg_list: expression ("," expression)*
method_call_expr: ref_expr "." IDENTIFIER "(" method_call_arg_list? ")" -> method_call_expr
group_expr: "group" "(" "[" ref_expr ("," ref_expr)* "]" ")" -> group_expr
selector_region: WELL_POS (":" WELL_POS)? -> selector_region
ref_expr: IDENTIFIER -> identifier_ref
    | ref_expr "[" expression "]" -> index_expr
    | ref_expr "[" selector_region ("," selector_region)* "]" -> plate_selector_expr
    | ref_expr "." IDENTIFIER -> member_expr
?batch_target_expr: ref_expr

list_literal: "[" (list_item ("," list_item)*)? "]"
?list_item: pair_expr
    | expression

record_literal: "{" (record_item ("," record_item)*)? "}"
record_item: record_key ":" expression
?record_key: IDENTIFIER -> record_key_identifier
    | STRING -> record_key_string

pair_expr: call_expr ":" expression -> pair_expr
?mutation_source_ref_expr: ref_expr
    | source_partition_expr
mutation_pair_expr: mutation_source_ref_expr ":" expression -> pair_expr


// ------------------------------------------------------------
// 4. Terminals
// ------------------------------------------------------------

// Identifiers: letter followed by alphanumerics/underscores. Language
// keywords are excluded so contextual lexing cannot treat them as names.
IDENTIFIER: /(?!include\b|import\b|protocol\b|returns\b|with\b|constraint\b|let\b|return\b|env\b|series\b|break\b|continue\b|repeat\b|in\b|if\b|else\b|or\b|and\b|group\b|markers\b|true\b|false\b)[A-Za-z][A-Za-z0-9_]*/
WELL_POS.3: /[A-Z]+[1-9][0-9]*/

// Quantity: number with optional unit suffix.
// Units are matched greedily; a negative lookahead prevents partial
// matches (e.g. "200Cool" tokenizes as QUANTITY(200) + IDENTIFIER(Cool),
// not QUANTITY(200C) + garbage).
// Longer unit strings are listed first so regex alternation picks them.
QUANTITY: /\d+(?:\.\d+)?(?:ng_per_uL|ug_per_mL|day|sec|rpm|rcf|pct|min|mL|ml|uL|ul|mM|uM|nM|nm|mW|mV|mg|ug|kg|um|hr|Hz|xg|ms|L|g|s|h|C|K|M|W|V|X|%)(?![A-Za-z0-9_])|\d+(?:\.\d+)?/

// Strings: double-quoted, with backslash escapes
STRING: /\"(?:\\.|[^\"\\])*\"/

// Booleans: true / false — priority 2 ensures they beat IDENTIFIER
BOOLEAN.2: "true" | "false"

// Mutation operator must beat COMPARE_OP tokenization on "<<"
MUTATE_OP.3: "<<"

// Comparison operators (named terminal so the transformer can read which op)
COMPARE_OP: "==" | "!=" | "<=" | ">=" | "<" | ">"


// ------------------------------------------------------------
// 5. Ignored tokens
// ------------------------------------------------------------

%ignore /\s+/
%ignore /\/\/[^\n]*/
%ignore /\/\*[\s\S]*?\*\//s
