protocol CurrentFrontendCore {
    let sample_tube = tube(label = "Incubate_Sample", capacity = 1000uL, load = [content(kind = bio_cellular, code = "INC01", type = cell_population, attrs = { state: suspension }):200uL]);
    let feed_stock = tube(label = "Incubate_Feed", capacity = 2000uL, load = [content(kind = formulation, code = "FD01", type = medium, attrs = { role: feed }):1000uL]);
    let gradient_tube = tube(label = "Gradient_Input", capacity = 2000uL, load = [content(kind = bio_cellular, code = "PBMC_Mix", type = cell_population, attrs = { state: suspension }):1200uL]);
    let stop_now = false;
    let skip_now = false;

    with env(thermal = 37C, duration = 30min) {
        repeat 3 {
            if stop_now {
                break;
            }
            if skip_now {
                continue;
            }
            sample_tube << [feed_stock:20uL];
        }
    }

    let sep_group = sep(sample = sample_tube, program = centrifuge_program( drive = 12000g));
    let frac_group = frac(sample = gradient_tube, program = density_gradient_program( axis = density, order = top_to_bottom, bins = 8));
    let img_obs = img(sample = sep_group[0], quantity = fluorescence, save_raw = true);

    sep_group[0] << [feed_stock:10uL];
}
