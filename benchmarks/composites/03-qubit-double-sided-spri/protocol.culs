include "../../modules/08-qubit-dsdna-hs/Qubit.culs";
include "../../modules/09-double-sided-spri/SPRI.culs";

protocol QubitToDoubleSidedSpri(standards, input_dna) returns (size_selected_dna) {
  let sample_group = [input_dna];
  // Source step S2: Run the Qubit 1X dsDNA HS module with the two standards and the original DNA tube, using 1 uL of DNA and returning its concentration readout while leaving 50 uL in that same tube.
  let concentration_group = QubitDsDnaHsBatch(
    standards = standards,
    sample_group = sample_group
  );
  let qubit_readout = concentration_group[0];
  let dna_concentration_ng_per_uL = qubit_readout.result.dna_concentration_ng_per_uL;

  // Source step S3: Pass the same original tube and its Qubit concentration result field to the double-sided SPRI module; use the declared fixed bead additions, perform both ethanol washes, and return the 50 uL eluate in a new tube without assigning a quantitative DNA recovery.
  let size_selected_dna = DoubleSidedSpriSelection(
    input_dna = input_dna,
    dna_concentration_ng_per_uL = dna_concentration_ng_per_uL
  );
  return size_selected_dna;
}

// Source step S1: Prepare two Qubit standards in their declared order and one original DNA tube containing 51 uL of DNA solution.
let qubit_standard_1 = tube(
  label = "QubitDsDnaHsStandard1",
  capacity = 100uL,
  load = [
    content(
      kind = ContentKind.BIO_MOLECULE_OR_VIRUS,
      type = ContentType.DNA,
      code = "QUBIT_DSDNA_HS_STANDARD_1",
      attrs = { role: calibration_standard, standard_order: 1, stock_concentration: 0ng_per_uL }
    ):10uL
  ]
);
let qubit_standard_2 = tube(
  label = "QubitDsDnaHsStandard2",
  capacity = 100uL,
  load = [
    content(
      kind = ContentKind.BIO_MOLECULE_OR_VIRUS,
      type = ContentType.DNA,
      code = "QUBIT_DSDNA_HS_STANDARD_2",
      attrs = { role: calibration_standard, standard_order: 2, stock_concentration: 10ng_per_uL }
    ):10uL
  ]
);
let standards = group([qubit_standard_1, qubit_standard_2]);
let dna_sample = tube(
  label = "DnaSample",
  capacity = 100uL,
  load = [
    content(
      kind = ContentKind.BIO_MOLECULE_OR_VIRUS,
      type = ContentType.DNA,
      code = "DNA_SAMPLE",
      attrs = { role: sample }
    ):51uL
  ]
);

let size_selected_dna = QubitToDoubleSidedSpri(
  standards = standards,
  input_dna = dna_sample
);
return size_selected_dna;
