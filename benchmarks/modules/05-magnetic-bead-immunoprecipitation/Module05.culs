protocol Module05_CaptureTargetProtein(sample, liquid_waste) returns (captured_ip_beads) {
  let target_capture_split = sep(
    sample = sample,
    program = magnetic_program(duration = 2min),
    component_fates = {
      PROTEIN_G_MAGNETIC_BEADS: { bound: 100%, flowthrough: 0% },
      ANTI_GFP_CAPTURE_ANTIBODY: { bound: 100%, flowthrough: 0% },
      GFP_TARGET_PROTEIN: { bound: 100%, flowthrough: 0% },
      LYSATE_BACKGROUND_PROTEINS: { bound: 0%, flowthrough: 100% },
      IP_LYSIS_BUFFER: { bound: 0%, flowthrough: 100% },
      ANTIBODY_BINDING_WASH_BUFFER: { bound: 0%, flowthrough: 100% }
    }
  );
  liquid_waste << [target_capture_split[1]];
  let captured_ip_beads = target_capture_split[0];
  return captured_ip_beads;
}

protocol Module05_ReleaseDenaturingEluate(sample, eluate_destination) returns (ip_eluate) {
  let elution_split = sep(
    sample = sample,
    program = magnetic_program(duration = 2min),
    component_fates = {
      PROTEIN_G_MAGNETIC_BEADS: { bound: 100%, flowthrough: 0% },
      ANTI_GFP_CAPTURE_ANTIBODY: { bound: 0%, flowthrough: 100% },
      GFP_TARGET_PROTEIN: { bound: 0%, flowthrough: 100% },
      DENATURING_ELUTION_BUFFER: { bound: 0%, flowthrough: 100% },
      LDS_REDUCING_BUFFER_4X: { bound: 0%, flowthrough: 100% }
    },
    transitions = [
      transition(
        subject = sample.materials.get("ANTI_GFP_CAPTURE_ANTIBODY"),
        output = MagneticProgramOutput.FLOWTHROUGH,
        to = MaterialRelation.FREE
      )
    ]
  );
  eluate_destination << [elution_split[1]] with constraint(low_carryover);
  let ip_eluate = eluate_destination;
  return ip_eluate;
}

protocol Module05_MagneticBeadImmunoprecipitation() returns (ip_result_group) {
  // Source step S1: Start with 500 uL clarified protein lysate containing 1 mg total protein in IP lysis buffer.
  // At this point the source identifies only the total lysate protein. Target and
  // background proteins are exposed after the Step 12 binding incubation.
  let clarified_protein_lysate = tube(label = "ClarifiedProteinLysate", capacity = 1.5mL, load = [
    content(
      kind = ContentKind.BIO_MOLECULE_OR_VIRUS,
      type = ContentType.PROTEIN,
      code = "CLARIFIED_LYSATE_TOTAL_PROTEIN",
      attrs = { role: total_protein, state: clarified_lysate }
    ):1mg,
    content(
      kind = ContentKind.FORMULATION,
      type = ContentType.BUFFER,
      code = "IP_LYSIS_BUFFER",
      attrs = { role: reaction_environment }
    ):500uL
  ]);

  let protein_g_bead_stock = tube(label = "ProteinGMagneticBeadStock", capacity = 1.5mL, load = [
    content(
      kind = ContentKind.PARTICULATE,
      type = ContentType.BEADS,
      code = "PROTEIN_G_MAGNETIC_BEADS",
      attrs = { role: capture, bead_property: magnetic }
    ):50uL,
    content(
      kind = ContentKind.FORMULATION,
      type = ContentType.BUFFER,
      code = "PROTEIN_G_BEAD_STORAGE_BUFFER",
      attrs = { role: storage }
    ):50uL
  ]);
  let anti_gfp_capture_antibody = tube(label = "AntiGfpCaptureAntibody", capacity = 200uL, load = [
    content(
      kind = ContentKind.BIO_MOLECULE_OR_VIRUS,
      type = ContentType.PROTEIN,
      code = "ANTI_GFP_CAPTURE_ANTIBODY",
      attrs = { role: antibody, target: GFP }
    ):50ug
  ]);
  let antibody_binding_wash_buffer = container(label = "AntibodyBindingAndWashBuffer", capacity = 20mL, load = [
    content(
      kind = ContentKind.FORMULATION,
      type = ContentType.BUFFER,
      code = "ANTIBODY_BINDING_WASH_BUFFER",
      attrs = { role: binding }
    ):10mL
  ]);
  let ip_wash_buffer = container(label = "IceColdIpWashBuffer", capacity = 20mL, load = [
    content(
      kind = ContentKind.FORMULATION,
      type = ContentType.BUFFER,
      code = "IP_WASH_BUFFER",
      attrs = { role: wash, thermal_state: ice_cold }
    ):10mL
  ]);
  let denaturing_elution_buffer = tube(label = "DenaturingElutionBuffer", capacity = 500uL, load = [
    content(
      kind = ContentKind.FORMULATION,
      type = ContentType.BUFFER,
      code = "DENATURING_ELUTION_BUFFER",
      attrs = { role: elution }
    ):400uL
  ]);
  let premixed_lds_reducing_4x = tube(label = "PremixedFourXLdsReducingBuffer", capacity = 500uL, load = [
    content(
      kind = ContentKind.FORMULATION,
      type = ContentType.BUFFER,
      code = "LDS_REDUCING_BUFFER_4X",
      attrs = { role: reaction_environment, concentration: "4x", reducing_agent: premixed }
    ):400uL
  ]);
  let liquid_waste = container(label = "ImmunoprecipitationLiquidWaste", capacity = 20mL);

  // Source step S2: Transfer 25 uL clarified lysate to a clean 1.5 mL tube as the input fraction and keep it at 0 C until the immunoprecipitation is complete. Preserve both the GFP target protein and the lysate background proteins in this fraction without assigning either an inferred mass.
  let input_fraction = tube(label = "InputFraction", capacity = 1.5mL);
  with env(thermal = 0C) {
    input_fraction << [clarified_protein_lysate:25uL];
  }
  input_fraction.materials.replace({
    input_fraction.materials.get("CLARIFIED_LYSATE_TOTAL_PROTEIN"): [
      content(
        kind = ContentKind.BIO_MOLECULE_OR_VIRUS,
        type = ContentType.PROTEIN,
        code = "GFP_TARGET_PROTEIN",
        attrs = { role: ip_target, state: free }
      ):unknown(dimension = mass),
      content(
        kind = ContentKind.BIO_MOLECULE_OR_VIRUS,
        type = ContentType.PROTEIN,
        code = "LYSATE_BACKGROUND_PROTEINS",
        attrs = { role: sample_background, state: free }
      ):unknown(dimension = mass)
    ]
  });

  // Source step S3: Vortex Protein G magnetic-bead slurry for 30 s to obtain a homogeneous suspension.
  agit(sample = protein_g_bead_stock, mode = "vortex", duration = 30s);

  // Source step S4: Transfer 50 uL homogeneous Protein G magnetic-bead slurry to a clean 1.5 mL tube.
  let ip_bead_tube = tube(label = "ProteinGIpBeadTube", capacity = 1.5mL);
  ip_bead_tube << [protein_g_bead_stock:50uL];

  // Source step S5: Place the bead tube on a magnetic rack for 2 min at 22 C, then remove and discard the storage supernatant while retaining the magnetic beads.
  with env(field = magnetic_rack) {
    with env(thermal = 22C, duration = 2min) {
      sep(
        sample = ip_bead_tube,
        program = magnetic_program(duration = 2min),
        component_fates = {
          PROTEIN_G_MAGNETIC_BEADS: { bound: 100%, flowthrough: 0% },
          PROTEIN_G_BEAD_STORAGE_BUFFER: { bound: 0%, flowthrough: 100% }
        }
      );
      liquid_waste << [ip_bead_tube.contents[1]];
    }
  }

  // Source step S6: Prepare 200 uL capture-antibody solution containing 5 ug anti-GFP antibody in antibody binding and washing buffer, then add the complete solution to the retained beads.
  let capture_antibody_solution = tube(label = "CaptureAntibodySolution", capacity = 500uL);
  capture_antibody_solution << [anti_gfp_capture_antibody:5ug, antibody_binding_wash_buffer:200uL];
  ip_bead_tube << [capture_antibody_solution];

  // Source step S7: Rotate the bead-antibody suspension at 20 rpm for 10 min at 22 C.
  // Rotation is represented with the currently supported rate-controlled shake mode.
  with env(thermal = 22C, duration = 10min) {
    agit(sample = ip_bead_tube, mode = "shake", duration = 10min, rate = 20rpm);
  }

  // Source step S8: Place the tube on the magnetic rack for 2 min at 22 C, then remove and discard the supernatant while retaining the antibody-conjugated beads.
  with env(field = magnetic_rack) {
    with env(thermal = 22C, duration = 2min) {
      sep(
        sample = ip_bead_tube,
        program = magnetic_program(duration = 2min),
        component_fates = {
          PROTEIN_G_MAGNETIC_BEADS: { bound: 100%, flowthrough: 0% },
          ANTI_GFP_CAPTURE_ANTIBODY: { bound: 100%, flowthrough: 0% },
          ANTIBODY_BINDING_WASH_BUFFER: { bound: 0%, flowthrough: 100% }
        }
      );
      liquid_waste << [ip_bead_tube.contents[1]];
    }
  }
  let antibody_conjugated_beads = ip_bead_tube;

  // Source step S9: Add 200 uL antibody binding and washing buffer to the antibody-conjugated beads and pipette 10 times using 160 uL per stroke.
  antibody_conjugated_beads << [antibody_binding_wash_buffer:200uL];
  repeat conjugated_bead_resuspension in schedule(start = 1, end = 10, step = 1) {
    antibody_conjugated_beads << [antibody_conjugated_beads:160uL];
  }

  // Source step S10: Place the tube on the magnetic rack for 2 min at 22 C, then remove and discard the wash supernatant while retaining the antibody-conjugated beads.
  with env(field = magnetic_rack) {
    with env(thermal = 22C, duration = 2min) {
      sep(
        sample = antibody_conjugated_beads,
        program = magnetic_program(duration = 2min),
        component_fates = {
          PROTEIN_G_MAGNETIC_BEADS: { bound: 100%, flowthrough: 0% },
          ANTI_GFP_CAPTURE_ANTIBODY: { bound: 100%, flowthrough: 0% },
          ANTIBODY_BINDING_WASH_BUFFER: { bound: 0%, flowthrough: 100% }
        }
      );
      liquid_waste << [antibody_conjugated_beads.contents[1]];
    }
  }

  // Source step S11: Add the remaining 475 uL clarified lysate and 25 uL antibody binding and washing buffer to the antibody-conjugated beads.
  antibody_conjugated_beads << [clarified_protein_lysate:475uL, antibody_binding_wash_buffer:25uL];

  // Source step S12: Rotate the 500 uL immunoprecipitation reaction at 20 rpm for 2 h at 4 C.
  with env(thermal = 4C, duration = 2h) {
    agit(sample = antibody_conjugated_beads, mode = "shake", duration = 2h, rate = 20rpm);
  }

  // The source gives 1 mg total protein but no target/background ratio. After
  // binding incubation, expose those constituents with unknown masses. Their
  // bound/flowthrough states are assigned by the following magnetic separation.
  antibody_conjugated_beads.materials.replace({
    antibody_conjugated_beads.materials.get("CLARIFIED_LYSATE_TOTAL_PROTEIN"): [
      content(
        kind = ContentKind.BIO_MOLECULE_OR_VIRUS,
        type = ContentType.PROTEIN,
        code = "GFP_TARGET_PROTEIN",
        attrs = { role: ip_target, state: free }
      ):unknown(dimension = mass),
      content(
        kind = ContentKind.BIO_MOLECULE_OR_VIRUS,
        type = ContentType.PROTEIN,
        code = "LYSATE_BACKGROUND_PROTEINS",
        attrs = { role: sample_background, state: free }
      ):unknown(dimension = mass)
    ]
  });

  // Source step S13: Place the tube on the magnetic rack for 2 min at 4 C.
  // Source step S14: Remove and discard the complete flowthrough without disturbing the retained beads.
  let captured_ip_beads = Module05_CaptureTargetProtein(
    sample = antibody_conjugated_beads,
    liquid_waste = liquid_waste
  );

  // Source step S15: Add 200 uL ice-cold IP wash buffer to the retained beads and pipette 10 times using 160 uL per stroke.
  captured_ip_beads << [ip_wash_buffer:200uL];
  repeat first_ip_wash_resuspension in schedule(start = 1, end = 10, step = 1) {
    captured_ip_beads << [captured_ip_beads:160uL];
  }

  // Source step S16: Rotate the bead suspension at 20 rpm for 5 min at 4 C.
  with env(thermal = 4C, duration = 5min) {
    agit(sample = captured_ip_beads, mode = "shake", duration = 5min, rate = 20rpm);
  }

  // Source step S17: Place the tube on the magnetic rack for 2 min at 4 C, then remove and discard the wash supernatant while retaining the beads.
  with env(field = magnetic_rack) {
    with env(thermal = 4C, duration = 2min) {
      sep(
        sample = captured_ip_beads,
        program = magnetic_program(duration = 2min),
        component_fates = {
          PROTEIN_G_MAGNETIC_BEADS: { bound: 100%, flowthrough: 0% },
          ANTI_GFP_CAPTURE_ANTIBODY: { bound: 100%, flowthrough: 0% },
          GFP_TARGET_PROTEIN: { bound: 100%, flowthrough: 0% },
          IP_WASH_BUFFER: { bound: 0%, flowthrough: 100% }
        }
      );
      liquid_waste << [captured_ip_beads.contents[1]];
    }
  }

  // Source step S18: Repeat steps 15-17 two additional times for a total of three washes.
  repeat additional_ip_wash_cycle in schedule(start = 1, end = 2, step = 1) {
    captured_ip_beads << [ip_wash_buffer:200uL];
    repeat additional_ip_wash_resuspension in schedule(start = 1, end = 10, step = 1) {
      captured_ip_beads << [captured_ip_beads:160uL];
    }
    with env(thermal = 4C, duration = 5min) {
      agit(sample = captured_ip_beads, mode = "shake", duration = 5min, rate = 20rpm);
    }
    with env(field = magnetic_rack) {
      with env(thermal = 4C, duration = 2min) {
        sep(
          sample = captured_ip_beads,
          program = magnetic_program(duration = 2min),
          component_fates = {
            PROTEIN_G_MAGNETIC_BEADS: { bound: 100%, flowthrough: 0% },
            ANTI_GFP_CAPTURE_ANTIBODY: { bound: 100%, flowthrough: 0% },
            GFP_TARGET_PROTEIN: { bound: 100%, flowthrough: 0% },
            IP_WASH_BUFFER: { bound: 0%, flowthrough: 100% }
          }
        );
        liquid_waste << [captured_ip_beads.contents[1]];
      }
    }
  }

  // Source step S19: Add 20 uL denaturing elution buffer and 10 uL premixed 4x LDS sample buffer containing reducing agent to the washed beads.
  captured_ip_beads << [denaturing_elution_buffer:20uL, premixed_lds_reducing_4x:10uL];

  // Source step S20: Pipette the 30 uL bead suspension 10 times using 24 uL per stroke, then heat it for 10 min at 70 C.
  repeat elution_resuspension in schedule(start = 1, end = 10, step = 1) {
    captured_ip_beads << [captured_ip_beads:24uL];
  }
  with env(thermal = 70C, duration = 10min) {
    hold(sample = captured_ip_beads);
  }

  // Source step S21: Place the tube on the magnetic rack for 2 min at 22 C.
  let eluate_destination = tube(label = "IpDenaturingEluate", capacity = 500uL);
  // Source step S22: Transfer the complete 30 uL eluate to a clean tube while leaving the spent magnetic beads in the original tube.
  let ip_eluate = Module05_ReleaseDenaturingEluate(
    sample = captured_ip_beads,
    eluate_destination = eluate_destination
  );

  // Source step S23: Return the 25 uL input fraction and 30 uL IP eluate as two separate materials while preserving their fraction identities for downstream analysis.
  let ip_result_group = group([input_fraction, ip_eluate]);
  return ip_result_group;
}
