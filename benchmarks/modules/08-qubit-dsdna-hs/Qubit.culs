protocol QubitDsDnaHsBatch(standards, sample_group) returns (concentration_group) {
  let calibration_readouts = QubitDsDnaHsCalibration(standards = standards);
  let concentration_group = data_group_ref(kind = "dna_concentration");
  repeat dna_sample in sample_group {
    let dna_concentration = QubitDsDnaHsSingleSample(
      dna_sample = dna_sample
    );
    concentration_group.items.append(dna_concentration);
  }
  return concentration_group;
}

protocol QubitDsDnaHsCalibration(standards) returns (calibration_readouts) {
  let qubit_1x_working_solution = tube(
    label = "Qubit1xDsDnaHsWorkingSolution",
    capacity = 1mL,
    load = [
      content(
        kind = ContentKind.FORMULATION,
        type = ContentType.OTHER_FORMULATION,
        code = "QUBIT_1X_DSDNA_HS_WORKING_SOLUTION",
        attrs = { role: assay_working_solution, concentration: "1x", ready_to_use: true }
      ):380uL
    ]
  );
  // Source step S1: Set up three clear, thin-wall 0.5 mL assay tubes: Standard 1, Standard 2, and DNA Sample. Label the lids rather than the sides of the tubes.
  let standard_1_assay = tube(label = "QubitStandard1Assay", capacity = 500uL);
  let standard_2_assay = tube(label = "QubitStandard2Assay", capacity = 500uL);


  // Source step S2: Add 10 uL of Qubit 1X dsDNA HS Standard 1, supplied at 0 ng/uL, to the Standard 1 tube.
  standard_1_assay << [standards[0]:10uL] with constraint(high_precision, low_carryover);
  // Source step S3: Add 10 uL of Qubit 1X dsDNA HS Standard 2, supplied at 10 ng/uL, to the Standard 2 tube.
  standard_2_assay << [standards[1]:10uL] with constraint(high_precision, low_carryover);

  // Source step S5: Add 190 uL of ready-to-use Qubit 1X dsDNA HS Working Solution to each standard tube and 199 uL to the DNA Sample tube. The final assay volume is 200 uL per tube.
  standard_1_assay << [qubit_1x_working_solution:190uL] with constraint(high_precision, low_carryover);
  standard_2_assay << [qubit_1x_working_solution:190uL] with constraint(high_precision, low_carryover);

  // Source step S6: Vortex all three tubes vigorously for 3-5 seconds without creating bubbles.
  agit(
    sample = group([standard_1_assay, standard_2_assay]),
    mode = "vortex",
    duration = 5s
  );

  // Source step S7: Incubate all three tubes at room temperature for 2 minutes.
  with env(thermal = 22C, duration = 2min) {
    hold(sample = group([standard_1_assay, standard_2_assay]));
  }

  let qubit_calibration_schema = data_schema(
    label = "QubitDsDnaHsTwoStandardCalibration",
    fields = [
      standard_id,
      standard_concentration_ng_per_uL,
      fluorescence_signal,
      calibration_status
    ]
  );
  // Source step S8: On the Qubit fluorometer, select the 1X dsDNA High Sensitivity assay and start a new standard calibration.
  // Source step S9: Insert the Standard 1 tube, close the instrument lid, and read Standard 1. Remove the tube when the reading is complete.
  // Source step S10: Insert the Standard 2 tube, close the instrument lid, and read Standard 2. Remove the tube when the reading is complete.
  let calibration_readouts = img(
    sample = group([standard_1_assay, standard_2_assay]),
    quantity = customized,
    schema_ref = qubit_calibration_schema,
    save_raw = true
  );

  return calibration_readouts;
}

protocol QubitDsDnaHsSingleSample(dna_sample) returns (dna_concentration) {
  let qubit_1x_working_solution = tube(
    label = "QubitSampleWorkingSolution",
    capacity = 1mL,
    load = [
      content(
        kind = ContentKind.FORMULATION,
        type = ContentType.OTHER_FORMULATION,
        code = "QUBIT_1X_DSDNA_HS_WORKING_SOLUTION",
        attrs = { role: assay_working_solution, concentration: "1x", ready_to_use: true }
      ):199uL
    ]
  );
  let dna_sample_assay = tube(label = "QubitDnaSampleAssay", capacity = 500uL);

  // Source step S4: Add 1 uL of the DNA sample to the DNA Sample tube.
  dna_sample_assay << [dna_sample:1uL] with constraint(high_precision, low_carryover);

  dna_sample_assay << [qubit_1x_working_solution:199uL] with constraint(high_precision, low_carryover);

  agit(sample = dna_sample_assay, mode = "vortex", duration = 5s);

  with env(thermal = 22C, duration = 2min) {
    hold(sample = dna_sample_assay);
  }

  let qubit_concentration_schema = data_schema(
    label = "QubitDsDnaHsCalculatedConcentration",
    fields = [
      sample_id,
      assay_sample_volume_uL,
      calibration_status,
      dna_concentration_ng_per_uL
    ]
  );
  // Source step S12: Insert the DNA Sample tube, close the instrument lid, and read the sample. Remove the tube when the reading is complete.
  let dna_concentration = img(
    sample = dna_sample_assay,
    quantity = customized,
    schema_ref = qubit_concentration_schema,
    save_raw = true
  );
  // Source step S11: Select the sample-reading mode. Set the sample volume to 1 uL and the output concentration unit to ng/uL.
  dna_concentration.result.assay_sample_volume_uL = 1;

  // Source step S13: Record and return the calculated concentration of the DNA sample in ng/uL as the protocol result.
  return dna_concentration;
}

protocol RunQubitDsDnaHsQuantification() returns (concentration_group) {
  let qubit_standard_1 = tube(
    label = "QubitDsDnaHsStandard1",
    capacity = 100uL,
    load = [
      content(
        kind = ContentKind.BIO_MOLECULE_OR_VIRUS,
        type = ContentType.DNA,
        code = "QUBIT_DSDNA_HS_STANDARD_1",
        attrs = { role: calibration_standard, standard_order: 1, stock_concentration: 0ng_per_uL }
      ):10uL
    ]
  );
  let qubit_standard_2 = tube(
    label = "QubitDsDnaHsStandard2",
    capacity = 100uL,
    load = [
      content(
        kind = ContentKind.BIO_MOLECULE_OR_VIRUS,
        type = ContentType.DNA,
        code = "QUBIT_DSDNA_HS_STANDARD_2",
        attrs = { role: calibration_standard, standard_order: 2, stock_concentration: 10ng_per_uL }
      ):10uL
    ]
  );
  let standards = group([qubit_standard_1, qubit_standard_2]);
  let dna_sample = tube(
    label = "DnaSample",
    capacity = 100uL,
    load = [
      content(
        kind = ContentKind.BIO_MOLECULE_OR_VIRUS,
        type = ContentType.DNA,
        code = "DNA_SAMPLE",
        attrs = { role: sample }
      ):51uL
    ]
  );

  let sample_group = [dna_sample];
  let concentration_group = QubitDsDnaHsBatch(
    standards = standards,
    sample_group = sample_group
  );
  return concentration_group;
}
