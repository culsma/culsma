protocol Module06_WashMembraneOnce(membrane_bath, tbst) {
  membrane_bath << [tbst:15mL];
  with env(thermal = 25C, duration = 5min) {
    agit(sample = membrane_bath, mode = "shake", duration = 5min, rate = 60rpm);
  }
}

protocol Module06_WesternBlot() returns (antibody_stained_membrane, western_blot_image) {
  // Source step S1: Start with 25 uL prepared protein sample containing 30 ug total protein in 1x reducing protein loading buffer.
  let prepared_protein_sample = tube(label = "PreparedReducingProteinSample", capacity = 100uL, load = [
    content(
      kind = ContentKind.BIO_MOLECULE_OR_VIRUS,
      type = ContentType.PROTEIN,
      code = "SAMPLE_TOTAL_PROTEIN",
      attrs = { role: analyte, loading_mass: "30ug" }
    ):30ug,
    content(
      kind = ContentKind.FORMULATION,
      type = ContentType.BUFFER,
      code = "REDUCING_PROTEIN_LOADING_BUFFER_1X",
      attrs = { role: reaction_environment, concentration: "1x" }
    ):25uL
  ]);

  // Source step S2: Mix the prepared protein sample by pipetting 10 times using 20 uL per stroke.
  repeat prepared_sample_mix in schedule(start = 1, end = 10, step = 1) {
    prepared_protein_sample << [prepared_protein_sample:20uL];
  }

  // Source step S3: Heat the prepared protein sample at 98 C for 15 min.
  with env(thermal = 98C, duration = 15min) {
    hold(sample = prepared_protein_sample);
  }

  // Source step S4: Spin down the sample at 3,000 x g for 5 s at 25 C.
  with env(thermal = 25C, duration = 5s) {
    sep(
      sample = prepared_protein_sample,
      program = centrifuge_program(drive = 3000g),
      component_fates = {
        SAMPLE_TOTAL_PROTEIN: { supernatant: 100%, pellet: 0% },
        REDUCING_PROTEIN_LOADING_BUFFER_1X: { supernatant: 100%, pellet: 0% }
      }
    );
  }

  // Source step S5: Install one 4-12% Bis-Tris SDS-PAGE gel in an electrophoresis tank.
  let bis_tris_gel = chamber(label = "BisTrisSdsPageGel", open = true, load = [
    content(
      kind = ContentKind.PARTICULATE,
      type = ContentType.OTHER_PARTICULATE,
      code = "BIS_TRIS_SDS_PAGE_GEL",
      attrs = { role: separation_matrix, format: "4-12_percent" }
    ):0uL
  ]);
  let electrophoresis_tank = chamber(label = "ElectrophoresisTank", capacity = 800mL, open = true);
  let sample_lane = well(
    label = "WesternBlotSampleLane",
    carrier_kind = "bis_tris_sds_page_gel",
    carrier_id = "BisTrisSdsPageGel",
    carrier_position = "A1",
    capacity = 50uL
  );
  let marker_lane = well(
    label = "WesternBlotMarkerLane",
    carrier_kind = "bis_tris_sds_page_gel",
    carrier_id = "BisTrisSdsPageGel",
    carrier_position = "A2",
    capacity = 50uL
  );
  let gel_electrophoresis_system = group([electrophoresis_tank, bis_tris_gel, sample_lane, marker_lane]);

  let running_buffer = container(label = "SDSPageRunningBufferBottle", capacity = 1L, load = [
    content(
      kind = ContentKind.FORMULATION,
      type = ContentType.BUFFER,
      code = "SDS_PAGE_RUNNING_BUFFER_1X",
      attrs = { role: reaction_environment }
    ):800mL
  ]);

  // Source step S6: Add 800 mL 1x SDS-PAGE running buffer to the electrophoresis tank.
  electrophoresis_tank << [running_buffer:800mL];

  // Source step S7: Load 25 uL denatured protein sample into the sample lane.
  sample_lane << [prepared_protein_sample:25uL];

  let prestained_protein_ladder = tube(label = "PrestainedProteinLadder", capacity = 100uL, load = [
    content(
      kind = ContentKind.BIO_MOLECULE_OR_VIRUS,
      type = ContentType.PROTEIN,
      code = "PRESTAINED_PROTEIN_LADDER",
      attrs = { role: molecular_weight_marker }
    ):100uL
  ]);

  // Source step S8: Load 10 uL prestained molecular-weight protein ladder into an adjacent marker lane.
  marker_lane << [prestained_protein_ladder:10uL];

  // Source step S9: Run the gel at 180 V for 30 min.
  let separated_sample_lane = sep(
    sample = sample_lane,
    program = field_program(voltage = 180V, duration = 30min),
    component_fates = {
      SAMPLE_TOTAL_PROTEIN: { target_band_fraction: 100%, non_target_fraction: 0% },
      REDUCING_PROTEIN_LOADING_BUFFER_1X: { target_band_fraction: 0%, non_target_fraction: 100% }
    }
  );
  let separated_marker_lane = sep(
    sample = marker_lane,
    program = field_program(voltage = 180V, duration = 30min),
    component_fates = {
      PRESTAINED_PROTEIN_LADDER: { target_band_fraction: 100%, non_target_fraction: 0% }
    }
  );
  let deionized_water = container(label = "DeionizedWaterBottle", capacity = 1L, load = [
    content(
      kind = ContentKind.FORMULATION,
      type = ContentType.BUFFER,
      code = "DEIONIZED_WATER",
      attrs = { role: rinse }
    ):500mL
  ]);
  let transfer_buffer = container(label = "TransferBufferTwentyPercentMethanol", capacity = 1L, load = [
    content(
      kind = ContentKind.FORMULATION,
      type = ContentType.BUFFER,
      code = "TRANSFER_BUFFER_20_PERCENT_METHANOL",
      attrs = { role: reaction_environment, methanol_fraction: "20_percent" }
    ):500mL
  ]);
  let membrane_solution_waste = chamber(label = "WesternBlotLiquidWaste", capacity = 1L);
  let membrane_equilibration_bath = chamber(label = "PVDFMembraneEquilibrationBath", capacity = 50mL, open = true, load = [
    content(
      kind = ContentKind.BIO_SUBCELLULAR,
      type = ContentType.MEMBRANE,
      code = "PVDF_MEMBRANE",
      attrs = { role: transfer_substrate, count: "1_piece" }
    ):0uL
  ]);

  // Source step S10: Add 15 mL deionized water and rinse the PVDF membrane for 2 min at 25 C.
  membrane_equilibration_bath << [deionized_water:15mL];
  with env(thermal = 25C, duration = 2min) {
    hold(sample = membrane_equilibration_bath);
  }

  // Source step S11: Remove the water, add 15 mL transfer buffer containing 20% methanol, and equilibrate the membrane for 15 min at 25 C.
  sep(
    sample = membrane_equilibration_bath,
    program = filtration_program(membrane = "pvdf_membrane", drive = "aspiration"),
    component_fates = {
      PVDF_MEMBRANE: { filtrate: 0%, retentate: 100% },
      DEIONIZED_WATER: { filtrate: 100%, retentate: 0% }
    }
  );
  membrane_solution_waste << [membrane_equilibration_bath.contents[0]];
  membrane_equilibration_bath << [transfer_buffer:15mL];
  with env(thermal = 25C, duration = 15min) {
    hold(sample = membrane_equilibration_bath);
  }

  // Source step S12: Equilibrate the separated gel in a separate 15 mL portion of transfer buffer containing 20% methanol for 15 min at 25 C.
  let gel_equilibration_bath = chamber(label = "GelEquilibrationBath", capacity = 50mL, open = true);
  gel_equilibration_bath << [transfer_buffer:15mL];
  let gel_equilibration_system = group([gel_equilibration_bath, bis_tris_gel, separated_sample_lane[0], separated_marker_lane[0]]);
  with env(thermal = 25C, duration = 15min) {
    hold(sample = gel_equilibration_system);
  }

  // Source step S13: Remove the membrane and gel equilibration buffers.
  sep(
    sample = membrane_equilibration_bath,
    program = filtration_program(membrane = "pvdf_membrane", drive = "aspiration"),
    component_fates = {
      PVDF_MEMBRANE: { filtrate: 0%, retentate: 100% },
      TRANSFER_BUFFER_20_PERCENT_METHANOL: { filtrate: 100%, retentate: 0% }
    }
  );
  membrane_solution_waste << [membrane_equilibration_bath.contents[0]];
  sep(
    sample = gel_equilibration_bath,
    program = filtration_program(membrane = "gel_retention", drive = "aspiration"),
    component_fates = {
      TRANSFER_BUFFER_20_PERCENT_METHANOL: { filtrate: 100%, retentate: 0% }
    }
  );
  membrane_solution_waste << [gel_equilibration_bath.contents[0]];

  // Source step S14: Assemble the transfer stack with the gel facing the negative electrode and the PVDF membrane facing the positive electrode, with no visible air bubbles between the gel and membrane.
  // Culsma currently has no ordered transfer-stack relation that records electrode-facing layer order or verifies absence of air bubbles.
  let gel_membrane_transfer_tank = chamber(label = "GelAndPvdfTransferTank", capacity = 50mL, open = true);

  // Source step S15: Add 30 mL transfer buffer containing 20% methanol to keep the transfer stack wet.
  gel_membrane_transfer_tank << [bis_tris_gel];
  gel_membrane_transfer_tank << [membrane_equilibration_bath];
  gel_membrane_transfer_tank << [separated_sample_lane[0]];
  gel_membrane_transfer_tank << [separated_marker_lane[0]];
  gel_membrane_transfer_tank << [transfer_buffer:30mL];

  let membrane_incubation_bath = chamber(label = "PVDFMembraneProcessingTank", capacity = 50mL, open = true);

  // Source step S16: Transfer proteins from the gel to the PVDF membrane at 100 V for 90 min at 4 C.
  with env(thermal = 4C, duration = 90min) {
    let transfer_split = sep(
      sample = gel_membrane_transfer_tank,
      program = field_program(voltage = 100V, duration = 90min),
      component_fates = {
        BIS_TRIS_SDS_PAGE_GEL: { target_band_fraction: 0%, non_target_fraction: 100% },
        PVDF_MEMBRANE: { target_band_fraction: 100%, non_target_fraction: 0% },
        SAMPLE_TOTAL_PROTEIN: { target_band_fraction: 100%, non_target_fraction: 0% },
        PRESTAINED_PROTEIN_LADDER: { target_band_fraction: 100%, non_target_fraction: 0% },
        TRANSFER_BUFFER_20_PERCENT_METHANOL: { target_band_fraction: 0%, non_target_fraction: 100% }
      }
    );
    // Source step S17: Move the transferred PVDF membrane to a clean membrane-processing tank.
    membrane_incubation_bath << [transfer_split[0]];
  }

  let tbst = container(label = "TBSTWashBufferBottle", capacity = 500mL, load = [
    content(
      kind = ContentKind.FORMULATION,
      type = ContentType.BUFFER,
      code = "TBST_CARRIER",
      attrs = { role: wash }
    ):300mL
  ]);

  // Source step S18: Rinse the transferred membrane once with 15 mL 1x TBST, then remove the TBST.
  membrane_incubation_bath << [tbst:15mL];
  sep(
    sample = membrane_incubation_bath,
    program = filtration_program(membrane = "pvdf_membrane", drive = "aspiration"),
    component_fates = {
      TBST_CARRIER: { filtrate: 100%, retentate: 0% },
      SAMPLE_TOTAL_PROTEIN: { filtrate: 0%, retentate: 100% },
      PRESTAINED_PROTEIN_LADDER: { filtrate: 0%, retentate: 100% }
    }
  );
  membrane_solution_waste << [membrane_incubation_bath.contents[0]];

  let nonfat_milk_powder = container(label = "NonfatMilkPowder", capacity = 50mL, load = [
    content(
      kind = ContentKind.BIO_MOLECULE_OR_VIRUS,
      type = ContentType.PROTEIN,
      code = "NONFAT_MILK_PROTEIN",
      attrs = { role: blocking_agent }
    ):2g
  ]);

  // Source step S19: Prepare 15 mL blocking buffer containing 5% w/v nonfat milk in 1x TBST.
  let blocking_buffer = chamber(label = "FivePercentMilkBlockingBuffer", capacity = 20mL);
  blocking_buffer << [nonfat_milk_powder:0.75g, tbst:15mL];

  // Source step S20: Add the complete 15 mL blocking buffer to the membrane and shake at 60 rpm for 1 h at 25 C.
  membrane_incubation_bath << [blocking_buffer];
  with env(thermal = 25C, duration = 1h) {
    agit(sample = membrane_incubation_bath, mode = "shake", duration = 1h, rate = 60rpm);
  }

  // Source step S21: Remove and discard the blocking buffer.
  sep(
    sample = membrane_incubation_bath,
    program = filtration_program(membrane = "pvdf_membrane", drive = "aspiration"),
    component_fates = {
      NONFAT_MILK_PROTEIN: { filtrate: 99%, retentate: 1% },
      TBST_CARRIER: { filtrate: 100%, retentate: 0% },
      SAMPLE_TOTAL_PROTEIN: { filtrate: 0%, retentate: 100% },
      PRESTAINED_PROTEIN_LADDER: { filtrate: 0%, retentate: 100% }
    }
  );
  membrane_solution_waste << [membrane_incubation_bath.contents[0]];

  // Source step S22: Wash the membrane three times with 15 mL 1x TBST for 5 min per wash at 25 C with shaking at 60 rpm, removing the wash buffer after each wash.
  repeat post_block_wash_cycle in schedule(start = 1, end = 3, step = 1) {
    Module06_WashMembraneOnce(
      membrane_bath = membrane_incubation_bath,
      tbst = tbst
    );
    sep(
      sample = membrane_incubation_bath,
      program = filtration_program(membrane = "pvdf_membrane", drive = "aspiration"),
      component_fates = {
        TBST_CARRIER: { filtrate: 100%, retentate: 0% },
        NONFAT_MILK_PROTEIN: { filtrate: 0%, retentate: 100% },
        SAMPLE_TOTAL_PROTEIN: { filtrate: 0%, retentate: 100% },
        PRESTAINED_PROTEIN_LADDER: { filtrate: 0%, retentate: 100% }
      }
    );
    membrane_solution_waste << [membrane_incubation_bath.contents[0]];
  }

  let bsa_powder = container(label = "BovineSerumAlbuminPowder", capacity = 50mL, load = [
    content(
      kind = ContentKind.BIO_MOLECULE_OR_VIRUS,
      type = ContentType.PROTEIN,
      code = "PRIMARY_DILUENT_BSA",
      attrs = { role: antibody_diluent }
    ):2g
  ]);

  // Source step S23: Prepare 10 mL primary-antibody dilution buffer containing 5% w/v BSA in 1x TBST.
  let primary_antibody_dilution_buffer = chamber(label = "FivePercentBsaPrimaryAntibodyDilutionBuffer", capacity = 15mL);
  primary_antibody_dilution_buffer << [bsa_powder:0.5g, tbst:10mL];

  let anti_alpha_tubulin_stock = tube(label = "MouseAntiAlphaTubulinDM1AStock", capacity = 100uL, load = [
    content(
      kind = ContentKind.BIO_MOLECULE_OR_VIRUS,
      type = ContentType.PROTEIN,
      code = "MOUSE_ANTI_ALPHA_TUBULIN_DM1A",
      attrs = { role: primary_antibody, target: alpha_tubulin, clone: DM1A }
    ):50uL
  ]);

  // Source step S24: Prepare 10 mL primary-antibody solution containing mouse anti-alpha-tubulin clone DM1A diluted 1:1,000 in the primary-antibody dilution buffer.
  let primary_antibody_solution = chamber(label = "AntiAlphaTubulinPrimaryAntibodySolution", capacity = 15mL);
  primary_antibody_solution << [primary_antibody_dilution_buffer:10mL, anti_alpha_tubulin_stock:10uL];

  // Source step S25: Add the complete primary-antibody solution to the membrane and shake at 60 rpm for 18 h at 4 C.
  membrane_incubation_bath << [primary_antibody_solution];
  with env(thermal = 4C, duration = 18h) {
    agit(sample = membrane_incubation_bath, mode = "shake", duration = 18h, rate = 60rpm);
  }

  // Source step S26: Remove and discard the primary-antibody solution.
  sep(
    sample = membrane_incubation_bath,
    program = filtration_program(membrane = "pvdf_membrane", drive = "aspiration"),
    component_fates = {
      TBST_CARRIER: { filtrate: 100%, retentate: 0% },
      NONFAT_MILK_PROTEIN: { filtrate: 0%, retentate: 100% },
      PRIMARY_DILUENT_BSA: { filtrate: 99%, retentate: 1% },
      MOUSE_ANTI_ALPHA_TUBULIN_DM1A: { filtrate: 99%, retentate: 1% },
      SAMPLE_TOTAL_PROTEIN: { filtrate: 0%, retentate: 100% },
      PRESTAINED_PROTEIN_LADDER: { filtrate: 0%, retentate: 100% }
    }
  );
  membrane_solution_waste << [membrane_incubation_bath.contents[0]];

  // Source step S27: Wash the membrane three times with 15 mL 1x TBST for 5 min per wash at 25 C with shaking at 60 rpm, removing the wash buffer after each wash.
  repeat post_primary_wash_cycle in schedule(start = 1, end = 3, step = 1) {
    Module06_WashMembraneOnce(
      membrane_bath = membrane_incubation_bath,
      tbst = tbst
    );
    sep(
      sample = membrane_incubation_bath,
      program = filtration_program(membrane = "pvdf_membrane", drive = "aspiration"),
      component_fates = {
        TBST_CARRIER: { filtrate: 100%, retentate: 0% },
        NONFAT_MILK_PROTEIN: { filtrate: 0%, retentate: 100% },
        PRIMARY_DILUENT_BSA: { filtrate: 0%, retentate: 100% },
        MOUSE_ANTI_ALPHA_TUBULIN_DM1A: { filtrate: 0%, retentate: 100% },
        SAMPLE_TOTAL_PROTEIN: { filtrate: 0%, retentate: 100% },
        PRESTAINED_PROTEIN_LADDER: { filtrate: 0%, retentate: 100% }
      }
    );
    membrane_solution_waste << [membrane_incubation_bath.contents[0]];
  }

  let secondary_antibody_stock = tube(label = "GoatAntiMouseIgGAlexaFluor680Stock", capacity = 100uL, load = [
    content(
      kind = ContentKind.BIO_MOLECULE_OR_VIRUS,
      type = ContentType.PROTEIN,
      code = "GOAT_ANTI_MOUSE_IGG_ALEXA_FLUOR_680",
      attrs = { role: secondary_antibody, target: mouse_primary }
    ):20uL
  ]);

  // Source step S28: Prepare 10 mL secondary-antibody solution containing goat anti-mouse IgG Alexa Fluor 680 diluted 1:10,000 in blocking buffer.
  let secondary_dilution_buffer = chamber(label = "FivePercentMilkSecondaryAntibodyDilutionBuffer", capacity = 15mL);
  secondary_dilution_buffer << [nonfat_milk_powder:0.5g, tbst:10mL];
  let secondary_antibody_solution = chamber(label = "AlexaFluor680SecondaryAntibodySolution", capacity = 15mL);
  secondary_antibody_solution << [secondary_dilution_buffer:10mL, secondary_antibody_stock:1uL];

  // Source step S29: Add the complete secondary-antibody solution to the membrane and shake at 60 rpm for 1 h at 25 C.
  membrane_incubation_bath << [secondary_antibody_solution];
  with env(thermal = 25C, duration = 1h) {
    agit(sample = membrane_incubation_bath, mode = "shake", duration = 1h, rate = 60rpm);
  }

  // Source step S30: Remove and discard the secondary-antibody solution.
  sep(
    sample = membrane_incubation_bath,
    program = filtration_program(membrane = "pvdf_membrane", drive = "aspiration"),
    component_fates = {
      TBST_CARRIER: { filtrate: 100%, retentate: 0% },
      NONFAT_MILK_PROTEIN: { filtrate: 99%, retentate: 1% },
      PRIMARY_DILUENT_BSA: { filtrate: 0%, retentate: 100% },
      MOUSE_ANTI_ALPHA_TUBULIN_DM1A: { filtrate: 0%, retentate: 100% },
      GOAT_ANTI_MOUSE_IGG_ALEXA_FLUOR_680: { filtrate: 99%, retentate: 1% },
      SAMPLE_TOTAL_PROTEIN: { filtrate: 0%, retentate: 100% },
      PRESTAINED_PROTEIN_LADDER: { filtrate: 0%, retentate: 100% }
    }
  );
  membrane_solution_waste << [membrane_incubation_bath.contents[0]];

  // Source step S31: Wash the membrane three times with 15 mL 1x TBST for 5 min per wash at 25 C with shaking at 60 rpm, removing the wash buffer after each wash.
  repeat post_secondary_wash_cycle in schedule(start = 1, end = 3, step = 1) {
    Module06_WashMembraneOnce(
      membrane_bath = membrane_incubation_bath,
      tbst = tbst
    );
    sep(
      sample = membrane_incubation_bath,
      program = filtration_program(membrane = "pvdf_membrane", drive = "aspiration"),
      component_fates = {
        TBST_CARRIER: { filtrate: 100%, retentate: 0% },
        NONFAT_MILK_PROTEIN: { filtrate: 0%, retentate: 100% },
        PRIMARY_DILUENT_BSA: { filtrate: 0%, retentate: 100% },
        MOUSE_ANTI_ALPHA_TUBULIN_DM1A: { filtrate: 0%, retentate: 100% },
        GOAT_ANTI_MOUSE_IGG_ALEXA_FLUOR_680: { filtrate: 0%, retentate: 100% },
        SAMPLE_TOTAL_PROTEIN: { filtrate: 0%, retentate: 100% },
        PRESTAINED_PROTEIN_LADDER: { filtrate: 0%, retentate: 100% }
      }
    );
    membrane_solution_waste << [membrane_incubation_bath.contents[0]];
  }

  let western_blot_schema = data_schema(
    label = "Module06WesternBlotImage",
    fields = [
      sample_lane_id,
      ladder_lane_id,
      channel_nm,
      antibody_target,
      alpha_tubulin_band_signal,
      molecular_weight_estimate_kDa,
      ladder_visible,
      imaging_qc_status,
      image_file
    ]
  );

  // Source step S32: Acquire a Western blot image in the 680 nm fluorescence channel, including both the alpha-tubulin sample lane and the prestained protein-ladder lane.
  let western_blot_image = img(
    sample = membrane_incubation_bath,
    quantity = customized,
    schema_ref = western_blot_schema,
    save_raw = true
  );

  return
    antibody_stained_membrane = membrane_incubation_bath,
    western_blot_image = western_blot_image;
}
