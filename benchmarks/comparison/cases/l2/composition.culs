protocol PrepareSample {
    let sample = tube(label = "prepared", capacity = 1.5mL, load = [
        content(kind = ContentKind.FORMULATION, type = ContentType.BUFFER, code = "BUFFER"):100uL]);
    return sample;
}
protocol TakeAliquot(sample, destination) {
    destination << [sample:10uL];
    return destination;
}
let prepared = PrepareSample();
let target = tube(label = "target", capacity = 1.5mL);
let result = TakeAliquot(sample = prepared, destination = target);
return result;
