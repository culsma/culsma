		parameter_reuse_CallBehaviorAction3:OutputPin1 -> parameter_reuse_CallBehaviorAction6:InputPin2 [label="" color=black]
		parameter_reuse_ForkNode1 -> parameter_reuse_CallBehaviorAction6:InputPin1 [label="" color=black]
		parameter_reuse_CallBehaviorAction5:"node" -> parameter_reuse_CallBehaviorAction6:"node" [label="" color=blue]
		parameter_reuse_InitialNode1 [label="" fillcolor=black shape=circle style=filled]
		parameter_reuse_FinalNode1 [label="" fillcolor=black shape=doublecircle style=filled]
		parameter_reuse_CallBehaviorAction1 [label=<<table border="0" cellspacing="0">
  <tr><td><table border="0" cellspacing="-2"><tr><td> </td><td port="ValuePin1" border="1">specification: stock_spec</td><td> </td><td port="ValuePin2" border="1">sample_array: stock</td><td> </td><td> </td></tr></table></td></tr>
  <tr><td port="node" border="1">EmptyContainer</td></tr>
  <tr><td><table border="0" cellspacing="-2"><tr><td> </td><td port="OutputPin1" border="1">samples</td><td> </td></tr></table></td></tr>
</table>> fillcolor=white shape=none style=rounded]
		parameter_reuse_CallBehaviorAction2 [label=<<table border="0" cellspacing="0">
  <tr><td><table border="0" cellspacing="-2"><tr><td> </td><td port="ValuePin1" border="1">specification: first_spec</td><td> </td><td port="ValuePin2" border="1">sample_array: first</td><td> </td><td> </td></tr></table></td></tr>
  <tr><td port="node" border="1">EmptyContainer</td></tr>
  <tr><td><table border="0" cellspacing="-2"><tr><td> </td><td port="OutputPin1" border="1">samples</td><td> </td></tr></table></td></tr>
</table>> fillcolor=white shape=none style=rounded]
		parameter_reuse_CallBehaviorAction3 [label=<<table border="0" cellspacing="0">
  <tr><td><table border="0" cellspacing="-2"><tr><td> </td><td port="ValuePin1" border="1">specification: second_spec</td><td> </td><td port="ValuePin2" border="1">sample_array: second</td><td> </td><td> </td></tr></table></td></tr>
  <tr><td port="node" border="1">EmptyContainer</td></tr>
  <tr><td><table border="0" cellspacing="-2"><tr><td> </td><td port="OutputPin1" border="1">samples</td><td> </td></tr></table></td></tr>
</table>> fillcolor=white shape=none style=rounded]
		parameter_reuse_CallBehaviorAction4 [label=<<table border="0" cellspacing="0">
  <tr><td><table border="0" cellspacing="-2"><tr><td> </td><td port="ValuePin1" border="1">resource: buffer</td><td> </td><td port="InputPin1" border="1">destination</td><td> </td><td port="ValuePin2" border="1">amount: 100.0 microliter</td><td> </td><td port="InputPin2" border="1">dispenseVelocity</td><td> </td><td> </td></tr></table></td></tr>
  <tr><td port="node" border="1">Provision</td></tr>
</table>> fillcolor=white shape=none style=rounded]
		parameter_reuse_CallBehaviorAction5 [label=<<table border="0" cellspacing="0">
  <tr><td><table border="0" cellspacing="-2"><tr><td> </td><td port="InputPin1" border="1">source</td><td> </td><td port="InputPin2" border="1">destination</td><td> </td><td port="ValuePin1" border="1">amount: 10.0 microliter</td><td> </td><td> </td></tr></table></td></tr>
  <tr><td port="node" border="1">Aliquot</td></tr>
</table>> fillcolor=white shape=none style=rounded]
		parameter_reuse_ForkNode1 [label="" fillcolor=black height=0.02 shape=rectangle style=filled]
		parameter_reuse_CallBehaviorAction6 [label=<<table border="0" cellspacing="0">
  <tr><td><table border="0" cellspacing="-2"><tr><td> </td><td port="InputPin1" border="1">source</td><td> </td><td port="InputPin2" border="1">destination</td><td> </td><td port="ValuePin1" border="1">amount: 20.0 microliter</td><td> </td><td> </td></tr></table></td></tr>
  <tr><td port="node" border="1">Aliquot</td></tr>
</table>> fillcolor=white shape=none style=rounded]
	}
