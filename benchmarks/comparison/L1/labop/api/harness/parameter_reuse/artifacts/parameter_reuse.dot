digraph _root {
	compound=true
	subgraph _root {
		compound=true
		subgraph cluster_Aliquot {
			graph [label=Aliquot shape=box]
			Aliquot_InitialNode1 -> Aliquot_FinalNode1 [label="" color=blue]
			Aliquot_InitialNode1 -> Aliquot_FinalNode1 [label="" color=blue]
			Aliquot_ActivityParameterNode3 -> Aliquot_CallBehaviorAction1:InputPin6 [label="" color=black]
			Aliquot_ActivityParameterNode2 -> Aliquot_CallBehaviorAction1:InputPin2 [label="" color=black]
			Aliquot_ActivityParameterNode1 -> Aliquot_CallBehaviorAction1:InputPin1 [label="" color=black]
			Aliquot_InitialNode1 -> Aliquot_CallBehaviorAction1:"node" [label="" color=blue]
			Aliquot_InitialNode1 [label="" fillcolor=black shape=circle style=filled]
			Aliquot_FinalNode1 [label="" fillcolor=black shape=doublecircle style=filled]
			Aliquot_ActivityParameterNode1 [label=source fillcolor=black peripheries=2 shape=rectangle]
			Aliquot_ActivityParameterNode2 [label=destination fillcolor=black peripheries=2 shape=rectangle]
			Aliquot_ActivityParameterNode3 [label=amount fillcolor=black peripheries=2 shape=rectangle]
			Aliquot_CallBehaviorAction1 [label=<<table border="0" cellspacing="0">
  <tr><td><table border="0" cellspacing="-2"><tr><td> </td><td port="InputPin1" border="1">source</td><td> </td><td port="InputPin2" border="1">destination</td><td> </td><td port="InputPin3" border="1">coordinates</td><td> </td><td port="InputPin4" border="1">replicates</td><td> </td><td port="InputPin5" border="1">temperature</td><td> </td><td port="InputPin6" border="1">amount</td><td> </td><td port="InputPin7" border="1">dispenseVelocity</td><td> </td><td> </td></tr></table></td></tr>
  <tr><td port="node" border="1">Transfer</td></tr>
</table>> fillcolor=white shape=none style=rounded]
		}
	}
	subgraph _root {
		compound=true
		subgraph cluster_Aliquot {
			graph [label=Aliquot shape=box]
			Aliquot_InitialNode1 -> Aliquot_FinalNode1 [label="" color=blue]
			Aliquot_InitialNode1 -> Aliquot_FinalNode1 [label="" color=blue]
			Aliquot_ActivityParameterNode3 -> Aliquot_CallBehaviorAction1:InputPin6 [label="" color=black]
			Aliquot_ActivityParameterNode2 -> Aliquot_CallBehaviorAction1:InputPin2 [label="" color=black]
			Aliquot_ActivityParameterNode1 -> Aliquot_CallBehaviorAction1:InputPin1 [label="" color=black]
			Aliquot_InitialNode1 -> Aliquot_CallBehaviorAction1:"node" [label="" color=blue]
			Aliquot_InitialNode1 [label="" fillcolor=black shape=circle style=filled]
			Aliquot_FinalNode1 [label="" fillcolor=black shape=doublecircle style=filled]
			Aliquot_ActivityParameterNode1 [label=source fillcolor=black peripheries=2 shape=rectangle]
			Aliquot_ActivityParameterNode2 [label=destination fillcolor=black peripheries=2 shape=rectangle]
			Aliquot_ActivityParameterNode3 [label=amount fillcolor=black peripheries=2 shape=rectangle]
			Aliquot_CallBehaviorAction1 [label=<<table border="0" cellspacing="0">
  <tr><td><table border="0" cellspacing="-2"><tr><td> </td><td port="InputPin1" border="1">source</td><td> </td><td port="InputPin2" border="1">destination</td><td> </td><td port="InputPin3" border="1">coordinates</td><td> </td><td port="InputPin4" border="1">replicates</td><td> </td><td port="InputPin5" border="1">temperature</td><td> </td><td port="InputPin6" border="1">amount</td><td> </td><td port="InputPin7" border="1">dispenseVelocity</td><td> </td><td> </td></tr></table></td></tr>
  <tr><td port="node" border="1">Transfer</td></tr>
</table>> fillcolor=white shape=none style=rounded]
		}
	}
	subgraph cluster_parameter_reuse {
		graph [label="default name" shape=box]
		parameter_reuse_InitialNode1 -> parameter_reuse_FinalNode1 [label="" color=blue]
		parameter_reuse_InitialNode1 -> parameter_reuse_CallBehaviorAction1:"node" [label="" color=blue]
		parameter_reuse_CallBehaviorAction1:"node" -> parameter_reuse_CallBehaviorAction2:"node" [label="" color=blue]
		parameter_reuse_CallBehaviorAction2:"node" -> parameter_reuse_CallBehaviorAction3:"node" [label="" color=blue]
		parameter_reuse_ForkNode1 -> parameter_reuse_CallBehaviorAction4:InputPin1 [label="" color=black]
		parameter_reuse_CallBehaviorAction3:"node" -> parameter_reuse_CallBehaviorAction4:"node" [label="" color=blue]
		parameter_reuse_CallBehaviorAction2:OutputPin1 -> parameter_reuse_CallBehaviorAction5:InputPin2 [label="" color=black]
