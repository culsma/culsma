protocol GfpLysateClarification {
  let cell_suspension = tube(label = "GfpCellSuspension", capacity = 1.5mL, load = [
    content(kind = ContentKind.BIO_CELLULAR, type = ContentType.MICROBIAL_CELLS,
      code = "GFP_EXPRESSING_MICROBIAL_CELLS", attrs = { state: suspension }):100000cells,
    content(kind = ContentKind.FORMULATION, type = ContentType.BUFFER,
      code = "LYSIS_COMPATIBLE_RESUSPENSION_BUFFER"):80uL]);
  let lysis_buffer_2x = tube(label = "LysisBuffer2x", capacity = 1.5mL, load = [
    content(kind = ContentKind.FORMULATION, type = ContentType.BUFFER,
      code = "LYSIS_BUFFER_2X", attrs = { role: lysis }):80uL]);
  let lysis_tube = tube(label = "LysisTube", capacity = 1.5mL);
  let clarified_lysate = tube(label = "ClarifiedLysate", capacity = 1.0mL);
  let debris_waste = tube(label = "DebrisWaste", capacity = 1.0mL);
  lysis_tube << [cell_suspension:80uL, lysis_buffer_2x:80uL];
  repeat lysis_pipette_mix in schedule(start = 1, end = 10, step = 1) {
    lysis_tube << [lysis_tube:128uL];
  }
  with env(thermal = 37C, duration = 30min) { hold(sample = lysis_tube); }
  with env(thermal = 22C, duration = 10min) {
    sep(sample = lysis_tube, program = centrifuge_program(drive = 12000g));
  }
  clarified_lysate << [lysis_tube.contents[0]:100uL];
  debris_waste << [lysis_tube.contents[1]];
  let lysate_readout = img(sample = clarified_lysate,
    quantity = fluorescence, save_raw = true);
  return lysate_readout;
}
let result = GfpLysateClarification();
return result;
