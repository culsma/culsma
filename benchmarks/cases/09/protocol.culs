protocol CellCultureWesternBlot returns (blot_image) {
    // Source step S1: seed HEK293T cells before transfection.
    let hek293t_cells = well(
        label = "HEK293TCells",
        capacity = 4000uL,
        carrier_id = "SixWellDish",
        carrier_position = "A1",
        load = [
            content(kind = ContentKind.BIO_CELLULAR, type = ContentType.CELL_LINE, code = "HEK293T", attrs = { state: adherent, pre_seeded_duration: "24h" }):200000cells,
            content(kind = ContentKind.FORMULATION, type = ContentType.MEDIUM, code = "DMEM_FBS_PENSTREP", attrs = { role: culture, base_medium: "DMEM", fbs: "10% v/v", penicillin_streptomycin: "1% v/v" }):2mL
        ]
    );
    let waste = container(label = "CellCultureLiquidWaste", capacity = 100mL);

    let opti_mem = tube(label = "OptiMEM", capacity = 1000uL, load = [content(kind = ContentKind.FORMULATION, type = ContentType.MEDIUM, code = "OPTI1", attrs = { role: culture }):500uL]);
    let gfp_rab7 = tube(label = "GFPRab7DNA", capacity = 100uL, load = [content(kind = ContentKind.BIO_MOLECULE_OR_VIRUS, type = ContentType.DNA, code = "RAB7DNA", attrs = { molecule_subtype: plasmid, role: vector }):20uL]);
    let lrrk1_construct = tube(label = "LRRK1DNA", capacity = 100uL, load = [content(kind = ContentKind.BIO_MOLECULE_OR_VIRUS, type = ContentType.DNA, code = "LRRK1DNA", attrs = { molecule_subtype: plasmid, role: vector }):20uL]);
    let pei = tube(label = "PEI", capacity = 100uL, load = [content(kind = ContentKind.CHEMICAL, type = ContentType.OTHER_CHEMICAL, code = "PEI1", attrs = { original_type: "custom_transfection_reagent" }):50uL]);
    // Source step S2: prepare and apply the PEI-DNA transfection mixture.
    let transfection_mix = tube(label = "PEITransfectionMix", capacity = 300uL);
    transfection_mix << [opti_mem:150uL, gfp_rab7:1uL, lrrk1_construct:2uL, pei:3uL];
    repeat transfection_mix_by_pipetting in schedule(start = 1, end = 10, step = 1) {
        transfection_mix << [transfection_mix:125uL];
    }
    with env(thermal = 25C, duration = 15min) {
        hold(sample = transfection_mix);
    }
    let transfection_dmem = tube(label = "DMEMWithFBSNoPenStrep", capacity = 2000uL, load = [content(kind = ContentKind.FORMULATION, type = ContentType.MEDIUM, code = "DMEM_FBS_NO_PENSTREP", attrs = { role: culture, base_medium: "DMEM", fbs: "10% v/v", penicillin_streptomycin: "0% v/v" }):1mL]);
    sep(
        sample = hek293t_cells,
        program = filtration_program(membrane = "adherent_cell_surface", drive = "aspiration"),
        component_fates = {
            HEK293T: { filtrate: 0%, retentate: 100% },
            DMEM_FBS_PENSTREP: { filtrate: 100%, retentate: 0% }
        }
    );
    waste << [hek293t_cells.contents[0]];
    hek293t_cells << [transfection_dmem:1mL];
    hek293t_cells << [transfection_mix:150uL];
    with env(thermal = 37C, duration = 36h) {
        hold(sample = hek293t_cells);
    }

    // Source step S3: wash, lyse, mix, and clarify the transfected cells.
    let cold_pbs = tube(label = "ColdPBS", capacity = 5000uL, load = [content(kind = ContentKind.FORMULATION, type = ContentType.BUFFER, code = "PBS1", attrs = { role: wash }):4000uL]);
    sep(
        sample = hek293t_cells,
        program = filtration_program(membrane = "adherent_cell_surface", drive = "aspiration"),
        component_fates = {
            HEK293T: { filtrate: 0%, retentate: 100% }
        }
    );
    waste << [hek293t_cells.contents[0]];
    hek293t_cells << [cold_pbs:1000uL];
    sep(
        sample = hek293t_cells,
        program = filtration_program(membrane = "adherent_cell_surface", drive = "aspiration"),
        component_fates = {
            HEK293T: { filtrate: 0%, retentate: 100% },
            PBS1: { filtrate: 100%, retentate: 0% }
        }
    );
    waste << [hek293t_cells.contents[0]];
    let ripa = tube(label = "RIPABuffer", capacity = 1000uL, load = [content(kind = ContentKind.FORMULATION, type = ContentType.BUFFER, code = "RIPA1", attrs = { role: lysis }):800uL]);
    let inhibitors = tube(label = "ProteasePhosphataseInhibitors", capacity = 100uL, load = [content(kind = ContentKind.FORMULATION, type = ContentType.BUFFER, code = "INHIB1", attrs = { role: inhibitor_cocktail }):50uL]);
    let lysate = tube(label = "CellLysate", capacity = 1500uL, load = [
        content(kind = ContentKind.BIO_MOLECULE_OR_VIRUS, type = ContentType.PROTEIN, code = "HEK293T_TOTAL_PROTEIN", attrs = { role: total_cellular_protein, basis: "200000_cells_at_200_pg_per_cell" }):40ug
    ]);
    with env(thermal = 0C, duration = 5min) {
        hek293t_cells << [ripa:300uL, inhibitors:10uL];
        let disruption_group = sep(
            sample = hek293t_cells,
            program = disrupt_program(duration = 5min)
        );
        lysate << [disruption_group[0]];
    }
    with env(thermal = 4C) {
        agit(sample = lysate, mode = shake, duration = 15min);
    }
    let clarified_lysate = tube(label = "ClarifiedLysate", capacity = 1000uL);
    with env(thermal = 4C, duration = 15min) {
        let clarified_group = sep(
            sample = lysate,
            program = centrifuge_program(drive = 12000g),
            component_fates = {
                HEK293T_TOTAL_PROTEIN: { supernatant: 100%, pellet: 0% },
                RIPA1: { supernatant: 100%, pellet: 0% },
                INHIB1: { supernatant: 100%, pellet: 0% }
            }
        );
        clarified_lysate << [clarified_group[0]:300uL];
    }

    let reducing_agent = tube(label = "ReducingAgent10x", capacity = 200uL, load = [content(kind = ContentKind.CHEMICAL, type = ContentType.OTHER_CHEMICAL, code = "RED1", attrs = { original_type: "custom_reducing_agent" }):100uL]);
    let lds_buffer = tube(label = "LDSBuffer4x", capacity = 500uL, load = [content(kind = ContentKind.FORMULATION, type = ContentType.BUFFER, code = "LDS1", attrs = { role: reaction_environment }):400uL]);
    // Source step S4: prepare and heat the reducing protein sample.
    let prepared_sample = tube(label = "PreparedProteinSample", capacity = 200uL);
    prepared_sample << [clarified_lysate:65uL, reducing_agent:10uL, lds_buffer:25uL];
    with env(thermal = 95C, duration = 10min) {
        hold(sample = prepared_sample);
    }

    let bis_tris_gel = chamber(label = "FourToTwelvePercentBisTrisGel", capacity = 600uL, open = true);
    let electrophoresis_tank = chamber(label = "PIO80356ElectrophoresisTank", capacity = 800mL);
    let mops_running_buffer = container(label = "MOPSRunningBufferBottle", capacity = 1L, load = [content(kind = ContentKind.FORMULATION, type = ContentType.BUFFER, code = "MOPS_RUNNING_BUFFER_1X", attrs = { role: reaction_environment }):800mL]);
    // Source step S5: load the Bis-Tris gel and run electrophoresis.
    let gel_lane = well(label = "BisTrisGelLane", capacity = 50uL, carrier_id = "BisTrisGel", carrier_position = "A1");
    electrophoresis_tank << [mops_running_buffer:800mL];
    gel_lane << [prepared_sample:25uL];
    // PM #100 bridge: slot 0 carries the complete lane state through the gel run.
    let gel_group = sep(
        sample = gel_lane,
        program = field_program(field = 180V, duration = 50min),
        component_fates = {
            HEK293T_TOTAL_PROTEIN: { target_band_fraction: 100%, non_target_fraction: 0% },
            RIPA1: { target_band_fraction: 100%, non_target_fraction: 0% },
            INHIB1: { target_band_fraction: 100%, non_target_fraction: 0% },
            RED1: { target_band_fraction: 100%, non_target_fraction: 0% },
            LDS1: { target_band_fraction: 100%, non_target_fraction: 0% }
        }
    );

    let methanol = tube(label = "Methanol", capacity = 50mL, load = [content(kind = ContentKind.CHEMICAL, type = ContentType.SOLVENT, code = "METHANOL", attrs = { role: activation }):50mL]);
    let water = container(label = "WaterBottle", capacity = 1L, load = [content(kind = ContentKind.FORMULATION, type = ContentType.BUFFER, code = "WATER", attrs = { role: rinse }):500mL]);
    let transfer_buffer = chamber(label = "TrisGlycineTransferBufferTwentyPercentMethanol", capacity = 1L, load = [content(kind = ContentKind.FORMULATION, type = ContentType.BUFFER, code = "TRIS_GLYCINE_TRANSFER_BUFFER_20_PERCENT_METHANOL", attrs = { role: reaction_environment }):500mL]);
    // Source step S6: activate PVDF, transfer proteins, rinse, and dry the membrane.
    let membrane_processing_tank = chamber(label = "PIO80356PVDFMembraneProcessingTank", capacity = 50mL, open = true, load = [content(kind = ContentKind.BIO_SUBCELLULAR, type = ContentType.MEMBRANE, code = "IMMOBILON_FL_PVDF_MEMBRANE", attrs = { role: transfer_substrate, count: "1_piece" }):0uL]);
    let membrane_solution_waste = chamber(label = "PIO80356MembraneSolutionWaste", capacity = 500mL);
    membrane_processing_tank << [methanol:15mL];
    with env(thermal = 25C, duration = 1min) {
        hold(sample = membrane_processing_tank);
    }
    let methanol_activation_split = sep(sample = membrane_processing_tank, program = filtration_program(membrane = "pvdf_membrane", drive = "aspiration"));
    membrane_solution_waste << [methanol_activation_split[0]];
    membrane_processing_tank << [water:15mL];
    with env(thermal = 25C, duration = 2min) {
        hold(sample = membrane_processing_tank);
    }
    let water_rinse_split = sep(sample = membrane_processing_tank, program = filtration_program(membrane = "pvdf_membrane", drive = "aspiration"));
    membrane_solution_waste << [water_rinse_split[0]];
    membrane_processing_tank << [transfer_buffer:15mL];
    let separated_gel = chamber(label = "PIO80356SeparatedGel", capacity = 50mL);
    separated_gel << [gel_group[0]];
    separated_gel << [transfer_buffer:15mL];
    with env(thermal = 25C, duration = 15min) {
        hold(sample = group([membrane_processing_tank, separated_gel]));
    }
    let transfer_buffer_equilibration_split = sep(sample = membrane_processing_tank, program = filtration_program(membrane = "pvdf_membrane", drive = "aspiration"));
    membrane_solution_waste << [transfer_buffer_equilibration_split[0]];
    let transfer_stack = chamber(label = "PIO80356TransferStack", capacity = 100mL);
    transfer_stack << [separated_gel, transfer_buffer_equilibration_split[1]];
    transfer_stack << [transfer_buffer:30mL];
    let transferred_membrane_tank = chamber(label = "PIO80356TransferredMembraneTank", capacity = 50mL, open = true);
    with env(thermal = 4C, duration = 4h) {
        let transferred_stack = sep(
            sample = transfer_stack,
            program = field_program(current = 200mA, duration = 4h),
            component_fates = {
                HEK293T_TOTAL_PROTEIN: { target_band_fraction: 100%, non_target_fraction: 0% },
                RIPA1: { target_band_fraction: 0%, non_target_fraction: 100% },
                INHIB1: { target_band_fraction: 0%, non_target_fraction: 100% },
                RED1: { target_band_fraction: 0%, non_target_fraction: 100% },
                LDS1: { target_band_fraction: 0%, non_target_fraction: 100% },
                TRIS_GLYCINE_TRANSFER_BUFFER_20_PERCENT_METHANOL: { target_band_fraction: 0%, non_target_fraction: 100% }
            }
        );
        transferred_membrane_tank << [transferred_stack[0]];
    }
    transferred_membrane_tank << [water:15mL];
    sep(
        sample = transferred_membrane_tank,
        program = filtration_program(membrane = "pvdf_membrane", drive = "aspiration"),
        component_fates = {
            HEK293T_TOTAL_PROTEIN: { filtrate: 0%, retentate: 100% },
            WATER: { filtrate: 100%, retentate: 0% }
        }
    );
    membrane_solution_waste << [transferred_membrane_tank.contents[0]];
    with env(thermal = 25C, duration = 10min) {
        hold(sample = transferred_membrane_tank);
    }

    // Source step S7: block, probe, wash, and image the membrane.
    let milk_block_tbs = chamber(label = "FivePercentMilkInTBS", capacity = 50mL, load = [content(kind = ContentKind.FORMULATION, type = ContentType.BUFFER, code = "MILK_5_PERCENT_TBS", attrs = { role: blocking }):30mL]);
    let primary_antibody_solution = chamber(label = "PrimaryAntibodyMixInFivePercentMilkTBST", capacity = 20mL, load = [content(kind = ContentKind.BIO_MOLECULE_OR_VIRUS, type = ContentType.PROTEIN, code = "PRIMARY_ANTIBODY_MIX", attrs = { role: antibody }):10mL]);
    let milk_tbst = chamber(label = "FivePercentMilkInTBST", capacity = 50mL, load = [content(kind = ContentKind.FORMULATION, type = ContentType.BUFFER, code = "MILK_5_PERCENT_TBST", attrs = { role: antibody_diluent }):30mL]);
    let tbst = chamber(label = "TBSTWashBuffer", capacity = 1L, load = [content(kind = ContentKind.FORMULATION, type = ContentType.BUFFER, code = "TBST_1X", attrs = { role: wash }):500mL]);
    transferred_membrane_tank << [milk_block_tbs:15mL];
    with env(thermal = 25C, duration = 1h) {
        agit(sample = transferred_membrane_tank, mode = "shake", duration = 1h, rate = 60rpm);
    }
    sep(
        sample = transferred_membrane_tank,
        program = filtration_program(membrane = "pvdf_membrane", drive = "aspiration"),
        component_fates = {
            HEK293T_TOTAL_PROTEIN: { filtrate: 0%, retentate: 100% },
            MILK_5_PERCENT_TBS: { filtrate: 95%, retentate: 5% }
        }
    );
    membrane_solution_waste << [transferred_membrane_tank.contents[0]];
    transferred_membrane_tank << [primary_antibody_solution:10mL];
    with env(thermal = 4C, duration = 16h) {
        agit(sample = transferred_membrane_tank, mode = "shake", duration = 16h, rate = 60rpm);
    }
    sep(
        sample = transferred_membrane_tank,
        program = filtration_program(membrane = "pvdf_membrane", drive = "aspiration"),
        component_fates = {
            HEK293T_TOTAL_PROTEIN: { filtrate: 0%, retentate: 100% },
            MILK_5_PERCENT_TBS: { filtrate: 0%, retentate: 100% },
            PRIMARY_ANTIBODY_MIX: { filtrate: 95%, retentate: 5% }
        }
    );
    membrane_solution_waste << [transferred_membrane_tank.contents[0]];

    repeat primary_wash in schedule(start = 1, end = 3, step = 1) {
        transferred_membrane_tank << [tbst:15mL];
        with env(thermal = 25C, duration = 5min) {
            agit(sample = transferred_membrane_tank, mode = "shake", duration = 5min, rate = 60rpm);
        }
        sep(
            sample = transferred_membrane_tank,
            program = filtration_program(membrane = "pvdf_membrane", drive = "aspiration"),
            component_fates = {
                HEK293T_TOTAL_PROTEIN: { filtrate: 0%, retentate: 100% },
                MILK_5_PERCENT_TBS: { filtrate: 0%, retentate: 100% },
                PRIMARY_ANTIBODY_MIX: { filtrate: 0%, retentate: 100% },
                TBST_1X: { filtrate: 100%, retentate: 0% }
            }
        );
        membrane_solution_waste << [transferred_membrane_tank.contents[0]];
    }
    transferred_membrane_tank << [milk_tbst:15mL];
    sep(
        sample = transferred_membrane_tank,
        program = filtration_program(membrane = "pvdf_membrane", drive = "aspiration"),
        component_fates = {
            HEK293T_TOTAL_PROTEIN: { filtrate: 0%, retentate: 100% },
            MILK_5_PERCENT_TBS: { filtrate: 0%, retentate: 100% },
            PRIMARY_ANTIBODY_MIX: { filtrate: 0%, retentate: 100% },
            MILK_5_PERCENT_TBST: { filtrate: 95%, retentate: 5% }
        }
    );
    membrane_solution_waste << [transferred_membrane_tank.contents[0]];

    let secondary_antibody_solution = chamber(label = "LiCorSecondaryAntibodyMixInFivePercentMilkTBST", capacity = 20mL, load = [content(kind = ContentKind.BIO_MOLECULE_OR_VIRUS, type = ContentType.PROTEIN, code = "LICOR_SECONDARY_ANTIBODY_MIX", attrs = { role: antibody }):10mL]);
    transferred_membrane_tank << [secondary_antibody_solution:10mL];
    with env(thermal = 25C, duration = 1h) {
        agit(sample = transferred_membrane_tank, mode = "shake", duration = 1h, rate = 60rpm);
    }
    sep(
        sample = transferred_membrane_tank,
        program = filtration_program(membrane = "pvdf_membrane", drive = "aspiration"),
        component_fates = {
            HEK293T_TOTAL_PROTEIN: { filtrate: 0%, retentate: 100% },
            MILK_5_PERCENT_TBS: { filtrate: 0%, retentate: 100% },
            PRIMARY_ANTIBODY_MIX: { filtrate: 0%, retentate: 100% },
            MILK_5_PERCENT_TBST: { filtrate: 0%, retentate: 100% },
            LICOR_SECONDARY_ANTIBODY_MIX: { filtrate: 95%, retentate: 5% }
        }
    );
    membrane_solution_waste << [transferred_membrane_tank.contents[0]];
    repeat secondary_wash in schedule(start = 1, end = 3, step = 1) {
        transferred_membrane_tank << [tbst:15mL];
        with env(thermal = 25C, duration = 5min) {
            agit(sample = transferred_membrane_tank, mode = "shake", duration = 5min, rate = 60rpm);
        }
        sep(
            sample = transferred_membrane_tank,
            program = filtration_program(membrane = "pvdf_membrane", drive = "aspiration"),
            component_fates = {
                HEK293T_TOTAL_PROTEIN: { filtrate: 0%, retentate: 100% },
                MILK_5_PERCENT_TBS: { filtrate: 0%, retentate: 100% },
                PRIMARY_ANTIBODY_MIX: { filtrate: 0%, retentate: 100% },
                MILK_5_PERCENT_TBST: { filtrate: 0%, retentate: 100% },
                LICOR_SECONDARY_ANTIBODY_MIX: { filtrate: 0%, retentate: 100% },
                TBST_1X: { filtrate: 100%, retentate: 0% }
            }
        );
        membrane_solution_waste << [transferred_membrane_tank.contents[0]];
    }

    let blot_schema = data_schema(label = "WesternBlotImage", fields = [rab7_phospho_s72_signal, gfp_signal, lrrk1_signal, gapdh_signal]);
    let blot_image = img(sample = transferred_membrane_tank, quantity = customized, schema_ref = blot_schema, save_raw = true);
    return blot_image;
 }

let western_blot_result = CellCultureWesternBlot();
