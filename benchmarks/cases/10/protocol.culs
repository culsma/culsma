protocol EvercodeWTMegaV3_RunSection2_1Batch(selected_lysate_count = 1) {
  // Batch execution wrapper: run the single-lysate Section 2.1 module once per
  // selected lysate. Batch reagent preparation tables are handled separately.
  repeat lysate_capture in schedule(start = 1, end = selected_lysate_count, step = 1) {
    EvercodeWTMegaV3_Section2_1_cDNACapture_Reviewed();
  }
}

protocol EvercodeWTMegaV3_Section2_1_cDNACapture_Reviewed {
  // Source preparation: Prepare ice, ethanol, room-temperature SPRI beads,
  // magnetic racks, vortex adapter, and Section 2.1 reagents.
  // Source step S1: Use one tube of barcoded lysate input material continuing
  // from lysate preparation or storage.
  let lysate = tube(
    label = "BarcodedCDNALysate",
    capacity = 250uL,
    load = [content(kind = ContentKind.BIO_MOLECULE_OR_VIRUS, type = ContentType.DNA, code = "LYSATE1", attrs = {state: lysate}):50uL]
  );
  let capture_enhancer = tube(
    label = "CaptureEnhancer",
    capacity = 50uL,
    load = [content(kind = ContentKind.CHEMICAL, type = ContentType.OTHER_CHEMICAL, code = "CE", attrs = {original_type: "custom_capture_enhancer"}):20uL]
  );
  // Source step S13: prepare the working bead tube with the specified initial load.
  let streptavidin_beads = tube(
    label = "StreptavidinBeads",
    capacity = 1500uL,
    load = [content(kind = ContentKind.PARTICULATE, type = ContentType.BEADS, code = "STREP_BEADS", attrs = {bead_property: "magnetic", role: capture}):44uL]
  );
  // Source step S1: remaining initial reagent declarations.
  let bead_wash_buffer = tube(
    label = "BeadWashBuffer",
    capacity = 500uL,
    load = [content(kind = ContentKind.FORMULATION, type = ContentType.BUFFER, code = "BWB", attrs = {role: wash}):200uL]
  );
  let binding_buffer = tube(
    label = "BindingBuffer",
    capacity = 500uL,
    load = [content(kind = ContentKind.FORMULATION, type = ContentType.BUFFER, code = "BB", attrs = {role: binding}):100uL]
  );
  let wash_buffer_1 = tube(
    label = "WashBuffer1",
    capacity = 1000uL,
    load = [content(kind = ContentKind.FORMULATION, type = ContentType.BUFFER, code = "WB1", attrs = {role: wash}):300uL]
  );
  let wash_buffer_2 = tube(
    label = "WashBuffer2",
    capacity = 1000uL,
    load = [content(kind = ContentKind.FORMULATION, type = ContentType.BUFFER, code = "WB2", attrs = {role: wash}):200uL]
  );
  let waste = tube(label = "Section2_1Waste", capacity = 5000uL);

  // Source step S2: If previously frozen, incubate lysate at 37C for 5 min,
  // confirm no precipitation, briefly centrifuge, and keep at room temperature.
  // If precipitation remains, the 37C incubation may be extended by 5 min.
  with env(thermal = 37C, duration = 5min) {
    hold(sample = lysate);
  }
  // Source step S3: precipitation check; no separate executable construct.
  // Source step S4: brief spin-down; annotation-only in this program.
  // Continued implementation for S4 includes a brief centrifuge. Authoring convention for brief
  // spin-down: 3000g for 5s; not represented as sep because no material
  // partition is intended.

  // Source step S5: Briefly centrifuge Capture Enhancer and gently mix by
  // pipetting 2x with a P20 set to 15 uL. The pipette mix is represented as
  // self-transfer. Brief spin-down convention: 3000g for 5s; not represented as
  // sep because no material partition is intended.
  repeat capture_enhancer_mix in schedule(start = 1, end = 2, step = 1) {
    capture_enhancer << [capture_enhancer:15uL];
  }

  // Source step S6: Add 2.5 uL Capture Enhancer to each tube of lysate.
  lysate << [capture_enhancer:2.5uL];

  // Source step S7: Secure tubes in the PCR rack, vortex on 100% power for
  // 1 min, then briefly centrifuge. Percent power is preserved in annotation;
  // brief spin-down convention: 3000g for 5s, not represented as sep.
  // Source step S8: secure the rack on the mixer; annotation-only.
  // Source step S9: vortex.
  agit(sample = lysate, mode = "vortex", duration = 1min);
  // Source step S10: remove and briefly centrifuge; annotation-only.

  // Source step S11: Incubate for 10 min at room temperature. Source permits
  // extension by 5 additional minutes, up to 15 min total.
  with env(thermal = 25C, duration = 10min) {
    hold(sample = lysate);
  }

  // Source step S12: Vortex Streptavidin Beads until fully mixed; for one
  // lysate, add 44 uL beads to a new 1.5 mL tube. The working bead tube was
  // initialized with 44 uL above for the one-lysate mainline.
  agit(sample = streptavidin_beads, mode = "vortex", duration = 15s);

  // Source step S14: Place beads on the 1.5 mL magnetic rack until clear,
  // about 2 min, then remove and discard the supernatant.
  with env(field = magnetic_rack) {
    sep(
      sample = streptavidin_beads,
      program = magnetic_program(duration = 2min)
    );
    // Source step S15: discard supernatant.
    waste << [streptavidin_beads.contents[1]];
  }

  // Source step S19: Wash bead pellet with 50 uL Bead Wash Buffer and repeat
  // for a total of 3 washes, discarding each supernatant and retaining beads.
  repeat bead_wash_cycle in schedule(start = 1, end = 3, step = 1) {
    // Source step S16: remove tube from magnet and fully resuspend bead pellet.
    streptavidin_beads << [bead_wash_buffer:50uL];
    // Authoring convention for source-only "fully resuspend": pipette 10x at
    // 80% of the 50 uL resuspension volume.
    repeat bead_resuspension_mix in schedule(start = 1, end = 10, step = 1) {
      streptavidin_beads << [streptavidin_beads:40uL];
    }

    // Source step S17: return to the magnetic rack until clear, about 2 min,
    // then discard supernatant.
    with env(field = magnetic_rack) {
      sep(
        sample = streptavidin_beads,
        program = magnetic_program(duration = 2min)
      );
      // Source step S18: discard the wash supernatant.
      waste << [streptavidin_beads.contents[1]];
    }
  }

  // Source step S20: Remove tube from magnet and resuspend washed bead
  // pellet in 55 uL Binding Buffer for one lysate. Keep the same tube binding;
  // do not alias it as a new prepared tube. The unspecified full resuspension
  // uses the agreed 10x pipette mix at 80% of 55 uL.
  // Source step S21: resuspend in binding buffer.
  streptavidin_beads << [binding_buffer:55uL];
  repeat bead_binding_buffer_resuspension in schedule(start = 1, end = 10, step = 1) {
    streptavidin_beads << [streptavidin_beads:44uL];
  }

  // Source step S22: Add 50 uL Streptavidin Beads in Binding Buffer to each tube
  // of lysate.
  lysate << [streptavidin_beads:50uL];

  // Source step S23: Secure tubes in PCR rack and vortex on 100% power for
  // 1 min. Percent power is preserved in annotation.
  // Source step S24: attach rack to mixer; annotation-only.
  // Source step S25: vortex.
  agit(sample = lysate, mode = "vortex", duration = 1min);

  // Source step S26: Vortex on 20% power, about 800-1000 rpm, for 30 min at
  // room temperature. Encoded at the lower bound, 800 rpm. The 10 min check
  // for settled beads is retained in annotation.
  with env(thermal = 25C, duration = 30min) {
    agit(sample = lysate, mode = "vortex", duration = 30min, rate = 800rpm);
  }

  // Source step S27: Remove tubes from vortex, briefly vortex on a standard
  // adapter, then briefly centrifuge without letting beads collect at the
  // bottom. Protocol-specific tested spin-down condition: 100g for 8s; this is
  // not represented as sep because no bead/liquid partition is intended.
  // Source step S28: vortex on the standard adapter.
  agit(sample = lysate, mode = "vortex");
  // Source step S29: brief centrifugation; annotation-only.

  // Source step S30: Place tubes on the high magnet position until the
  // solution clears, about 2 min. Ensure supernatant is clear. While still on
  // the magnetic rack, remove and discard supernatant. This is one magnetic
  // separation action; high magnet position is execution-layer mapping.
  with env(field = magnetic_rack) {
    sep(
      sample = lysate,
      program = magnetic_program(duration = 2min),
      component_fates = {
        CE: { bound: 0%, flowthrough: 100% },
        LYSATE1: { bound: 100%, flowthrough: 0% }
      }
    );
    // Source step S31: ensure clear supernatant; annotation-only.
    // Source step S32: discard supernatant.
    waste << [lysate.contents[1]];
  }

  // Source step S33: Remove tubes from magnet, fully resuspend bead pellet
  // with 125 uL Wash Buffer 1, incubate 1 min at room temperature, return to
  // high magnet until clear about 2 min, discard supernatant while still on the
  // rack, and repeat once for 2 total Wash Buffer 1 washes.
  // Source step S38: repeat the wash cycle.
  repeat captured_cdna_wash_cycle in schedule(start = 1, end = 2, step = 1) {
    // Source step S34: resuspend with Wash Buffer 1.
    lysate << [wash_buffer_1:125uL];
    // Authoring convention for source-only "fully resuspend": pipette 10x at
    // 80% of the 125 uL resuspension volume.
    repeat captured_cdna_resuspension_mix in schedule(start = 1, end = 10, step = 1) {
      lysate << [lysate:100uL];
    }
    // Source step S35: incubate the wash.
    with env(thermal = 25C, duration = 1min) {
      hold(sample = lysate);
    }
    // Source step S36: clear on the magnetic rack.
    with env(field = magnetic_rack) {
      sep(
        sample = lysate,
        program = magnetic_program(duration = 2min)
      );
      // Source step S37: discard wash supernatant.
      waste << [lysate.contents[1]];
    }
  }

  // Source step S39: Remove tubes from magnet, fully resuspend each bead
  // pellet with 125 uL Wash Buffer 2, save Wash Buffer 2 for optional storage,
  // incubate 1 min at room temperature, then continue to the template-switch
  // reaction module. The
  // unspecified full resuspension uses 10x pipette mix at 80% of 125 uL.
  // Source step S40: resuspend with Wash Buffer 2.
  lysate << [wash_buffer_2:125uL];
  repeat wash2_resuspension_mix in schedule(start = 1, end = 10, step = 1) {
    lysate << [lysate:100uL];
  }
  // Source step S41: incubate Wash Buffer 2.
  with env(thermal = 25C, duration = 1min) {
    hold(sample = lysate);
  }

  // Source step S42: continue with the returned material.
  return lysate;
}

EvercodeWTMegaV3_RunSection2_1Batch();
