protocol TransfectionAndImmunocytochemistry returns (confocal_image) {
  let waste = tube(label = "ImmunocytochemistryWaste", capacity = 20mL);
  let aspiration = filtration_program(
    membrane = "adherent_cell_surface",
    drive = "aspiration"
  );

  // Source step S1: Seed RPE1 Cells for Fixed-Cell Imaging.
  let rpe1_cells = well(
    label = "RPE1Cells",
    capacity = 800uL,
    carrier_id = "GlassBottomDish",
    carrier_position = "A1",
    load = [
      content(kind = ContentKind.BIO_CELLULAR, type = ContentType.CELL_LINE, code = "RPE1", attrs = { culture_state: adherent, role: material }):100000cells,
      content(kind = ContentKind.FORMULATION, type = ContentType.MEDIUM, code = "DMEM_F12_COMPLETE", attrs = { role: culture }):300uL
    ]
  );
  let culture_media = tube(label = "DMEMF12Complete", capacity = 5mL, load = [
    content(kind = ContentKind.FORMULATION, type = ContentType.MEDIUM, code = "DMEM_F12_COMPLETE", attrs = { role: culture }):4mL
  ]);
  rpe1_cells << [culture_media:350uL];
  with env(thermal = 37C, co2 = 5%, duration = 24h) {
    hold(sample = rpe1_cells);
  }

  // Source step S2: Prepare and Apply Transfection Mixture.
  let opti_mem = tube(label = "OptiMEM", capacity = 1mL, load = [
    content(kind = ContentKind.FORMULATION, type = ContentType.MEDIUM, code = "OPTI_MEM", attrs = { role: reaction_environment }):500uL
  ]);
  let lipofectamine_2000 = tube(label = "Lipofectamine2000", capacity = 100uL, load = [
    content(kind = ContentKind.FORMULATION, type = ContentType.SUPPLEMENT, code = "LIPOFECTAMINE_2000", attrs = { role: transfection_reagent }):20uL
  ]);
  let plasmid_dna = tube(label = "PlasmidDNA", capacity = 100uL, load = [
    content(kind = ContentKind.BIO_MOLECULE_OR_VIRUS, type = ContentType.DNA, code = "PLASMID_DNA", attrs = { molecule_subtype: plasmid, role: vector }):20uL
  ]);
  let transfection_mix = tube(label = "TransfectionMix106uL", capacity = 300uL);
  transfection_mix << [opti_mem:100uL, lipofectamine_2000:4uL, plasmid_dna:2uL];
  with env(thermal = 25C, duration = 20min) {
    hold(sample = transfection_mix);
  }
  rpe1_cells << [transfection_mix:106uL];
  with env(thermal = 37C, co2 = 5%, duration = 48h) {
    hold(sample = rpe1_cells);
  }

  // Source step S3: Serum-Starve Cells for the Representative Imaging Condition.
  let serum_free_media = tube(label = "SerumFreeDMEMF12", capacity = 5mL, load = [
    content(kind = ContentKind.FORMULATION, type = ContentType.MEDIUM, code = "DMEM_F12_SERUM_FREE", attrs = { role: culture }):4mL
  ]);
  sep(sample = rpe1_cells, program = aspiration);
  waste << [rpe1_cells.contents[0]];
  rpe1_cells << [serum_free_media:500uL];
  with env(thermal = 37C, co2 = 5%, duration = 48h) {
    hold(sample = rpe1_cells);
  }

  // Source step S4: Fix Cells.
  let pfa_4pct = tube(label = "Paraformaldehyde4Percent", capacity = 1mL, load = [
    content(kind = ContentKind.CHEMICAL, type = ContentType.ORGANIC_COMPOUND, code = "PFA_4PCT_IN_PBS", attrs = { role: fixative }):1mL
  ]);
  sep(sample = rpe1_cells, program = aspiration);
  waste << [rpe1_cells.contents[0]];
  rpe1_cells << [pfa_4pct:300uL];
  with env(thermal = 25C, duration = 20min) {
    hold(sample = rpe1_cells);
  }
  sep(sample = rpe1_cells, program = aspiration);
  waste << [rpe1_cells.contents[0]];
  let pbs = tube(label = "PBS", capacity = 10mL, load = [
    content(kind = ContentKind.FORMULATION, type = ContentType.BUFFER, code = "PBS", attrs = { role: wash }):8mL
  ]);
  repeat fixation_wash_cycle in schedule(start = 1, end = 3, step = 1) {
    rpe1_cells << [pbs:500uL];
    sep(sample = rpe1_cells, program = aspiration);
    waste << [rpe1_cells.contents[0]];
  }

  // Source step S5: Permeabilize, Quench, and Block Cells.
  sep(sample = rpe1_cells, program = aspiration);
  waste << [rpe1_cells.contents[0]];
  let triton_extraction_buffer = tube(label = "TritonExtractionBuffer", capacity = 1mL, load = [
    content(kind = ContentKind.CHEMICAL, type = ContentType.DETERGENT, code = "TRITON_X100_EXTRACTION_BUFFER", attrs = { role: permeabilization }):1mL
  ]);
  rpe1_cells << [triton_extraction_buffer:300uL];
  with env(thermal = 25C, duration = 10min) {
    hold(sample = rpe1_cells);
  }
  sep(sample = rpe1_cells, program = aspiration);
  waste << [rpe1_cells.contents[0]];
  let sodium_borohydride = tube(label = "SodiumBorohydrideInPBS", capacity = 1mL, load = [
    content(kind = ContentKind.CHEMICAL, type = ContentType.INORGANIC_COMPOUND, code = "SODIUM_BOROHYDRIDE_IN_PBS", attrs = { role: quench }):1mL
  ]);
  rpe1_cells << [sodium_borohydride:300uL];
  with env(thermal = 25C, duration = 7min) {
    hold(sample = rpe1_cells);
  }
  sep(sample = rpe1_cells, program = aspiration);
  waste << [rpe1_cells.contents[0]];
  let bsa_block = tube(label = "BSA5PercentBlock", capacity = 1mL, load = [
    content(kind = ContentKind.FORMULATION, type = ContentType.BUFFER, code = "BSA_5PCT_IN_PBS", attrs = { role: reaction_environment }):1mL
  ]);
  rpe1_cells << [bsa_block:300uL];
  with env(thermal = 25C, duration = 30min) {
    hold(sample = rpe1_cells);
  }

  // Source step S6: Primary Antibody Incubation and Washes.
  sep(sample = rpe1_cells, program = aspiration);
  waste << [rpe1_cells.contents[0]];
  let primary_antibody = tube(label = "PrimaryAntibodySolution", capacity = 500uL, load = [
    content(kind = ContentKind.BIO_MOLECULE_OR_VIRUS, type = ContentType.PROTEIN, code = "PRIMARY_ANTIBODY", attrs = { role: antibody }):0uL,
    content(kind = ContentKind.FORMULATION, type = ContentType.BUFFER, code = "PRIMARY_ANTIBODY_DILUENT", attrs = { role: reaction_environment }):300uL
  ]);
  rpe1_cells << [primary_antibody:300uL];
  with env(thermal = 4C, duration = 16h) {
    hold(sample = rpe1_cells);
  }
  sep(sample = rpe1_cells, program = aspiration);
  waste << [rpe1_cells.contents[0]];
  repeat post_primary_wash_cycle in schedule(start = 1, end = 3, step = 1) {
    rpe1_cells << [pbs:500uL];
    sep(sample = rpe1_cells, program = aspiration);
    waste << [rpe1_cells.contents[0]];
  }

  // Source step S7: Secondary Antibody Incubation and Washes.
  sep(sample = rpe1_cells, program = aspiration);
  waste << [rpe1_cells.contents[0]];
  let secondary_antibody = tube(label = "AlexaFluorSecondaryAntibodySolution", capacity = 500uL, load = [
    content(kind = ContentKind.BIO_MOLECULE_OR_VIRUS, type = ContentType.PROTEIN, code = "ALEXA_FLUOR_SECONDARY_ANTIBODY", attrs = { role: antibody }):0uL,
    content(kind = ContentKind.FORMULATION, type = ContentType.BUFFER, code = "SECONDARY_ANTIBODY_DILUENT", attrs = { role: reaction_environment }):300uL
  ]);
  rpe1_cells << [secondary_antibody:300uL];
  with env(thermal = 25C, duration = 1h) {
    hold(sample = rpe1_cells);
  }
  sep(sample = rpe1_cells, program = aspiration);
  waste << [rpe1_cells.contents[0]];
  repeat post_secondary_wash_cycle in schedule(start = 1, end = 3, step = 1) {
    rpe1_cells << [pbs:500uL];
    sep(sample = rpe1_cells, program = aspiration);
    waste << [rpe1_cells.contents[0]];
  }

  // Source step S8: Nuclear Staining and Image Acquisition.
  sep(sample = rpe1_cells, program = aspiration);
  waste << [rpe1_cells.contents[0]];
  let dapi = tube(label = "DAPIWorkingNuclearStain", capacity = 500uL, load = [
    content(kind = ContentKind.CHEMICAL, type = ContentType.DYE, code = "DAPI_WORKING_STAIN", attrs = { role: stain }):300uL
  ]);
  rpe1_cells << [dapi:300uL];
  with env(thermal = 25C, duration = 15min) {
    hold(sample = rpe1_cells);
  }
  sep(sample = rpe1_cells, program = aspiration);
  waste << [rpe1_cells.contents[0]];
  rpe1_cells << [pbs:500uL];
  sep(sample = rpe1_cells, program = aspiration);
  waste << [rpe1_cells.contents[0]];
  let mounting_solution = tube(label = "MountingSolution", capacity = 500uL, load = [
    content(kind = ContentKind.FORMULATION, type = ContentType.OTHER_FORMULATION, code = "MOUNTING_SOLUTION", attrs = { role: mounting }):300uL
  ]);
  rpe1_cells << [mounting_solution:100uL];
  let image_schema = data_schema(
    label = "ConfocalCellImage",
    fields = [cell_count, fluorescence_signal, field_quality]
  );
  let confocal_image = img(
    sample = rpe1_cells,
    quantity = customized,
    schema_ref = image_schema,
    save_raw = true
  );
  return confocal_image;
}

let imaging_result = TransfectionAndImmunocytochemistry();
return imaging_result;
