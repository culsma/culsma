protocol RunInputSdsPageQcLane(input_sample, lane) returns (separated_lane) {
  lane << [input_sample:20uL];
  let lane_run = sep(
    sample = lane,
    program = field_program(field = 200V, duration = 45min),
    component_fates = {
      HIS_TAGGED_TARGET_PROTEIN: { target_band_fraction: 100%, non_target_fraction: 0% },
      NATIVE_LYSIS_BINDING_BUFFER: { target_band_fraction: 100%, non_target_fraction: 0% },
      REDUCING_SDS_PAGE_LOADING_DYE_2X: { target_band_fraction: 100%, non_target_fraction: 0% }
    }
  );
  let separated_lane = lane_run[0];
  return separated_lane;
}

protocol RunFlowthroughSdsPageQcLane(input_sample, lane) returns (separated_lane) {
  lane << [input_sample:20uL];
  let lane_run = sep(
    sample = lane,
    program = field_program(field = 200V, duration = 45min),
    component_fates = {
      NATIVE_LYSIS_BINDING_BUFFER: { target_band_fraction: 100%, non_target_fraction: 0% },
      REDUCING_SDS_PAGE_LOADING_DYE_2X: { target_band_fraction: 100%, non_target_fraction: 0% }
    }
  );
  let separated_lane = lane_run[0];
  return separated_lane;
}

protocol RunWashSdsPageQcLane(input_sample, lane) returns (separated_lane) {
  lane << [input_sample:20uL];
  let lane_run = sep(
    sample = lane,
    program = field_program(field = 200V, duration = 45min),
    component_fates = {
      NATIVE_WASH_BUFFER: { target_band_fraction: 100%, non_target_fraction: 0% },
      REDUCING_SDS_PAGE_LOADING_DYE_2X: { target_band_fraction: 100%, non_target_fraction: 0% }
    }
  );
  let separated_lane = lane_run[0];
  return separated_lane;
}

protocol RunElutionSdsPageQcLane(input_sample, lane) returns (separated_lane) {
  lane << [input_sample:20uL];
  let lane_run = sep(
    sample = lane,
    program = field_program(field = 200V, duration = 45min),
    component_fates = {
      HIS_TAGGED_TARGET_PROTEIN: { target_band_fraction: 100%, non_target_fraction: 0% },
      NATIVE_ELUTION_BUFFER: { target_band_fraction: 100%, non_target_fraction: 0% },
      REDUCING_SDS_PAGE_LOADING_DYE_2X: { target_band_fraction: 100%, non_target_fraction: 0% }
    }
  );
  let separated_lane = lane_run[0];
  return separated_lane;
}

protocol RunSingleSdsPageMarkerLane(marker_sample, lane) returns (separated_lane) {
  lane << [marker_sample:10uL];
  let lane_run = sep(
    sample = lane,
    program = field_program(field = 200V, duration = 45min),
    component_fates = {
      MOLECULAR_WEIGHT_LADDER: { target_band_fraction: 100%, non_target_fraction: 0% }
    }
  );
  let separated_lane = lane_run[0];
  return separated_lane;
}

protocol RunSdsPageLaneGroup(input_sample, flowthrough_sample, wash_sample, elution1_sample, elution2_sample, ladder_sample) returns (separated_lane_group) {
  let lane_input = well(label = "InputLane", carrier_id = "TB08SdsPageGel", carrier_position = "A1", capacity = 50uL);
  let lane_flowthrough = well(label = "FlowthroughLane", carrier_id = "TB08SdsPageGel", carrier_position = "A2", capacity = 50uL);
  let lane_wash = well(label = "PooledWashLane", carrier_id = "TB08SdsPageGel", carrier_position = "A3", capacity = 50uL);
  let lane_elution1 = well(label = "Elution1Lane", carrier_id = "TB08SdsPageGel", carrier_position = "A4", capacity = 50uL);
  let lane_elution2 = well(label = "Elution2Lane", carrier_id = "TB08SdsPageGel", carrier_position = "A5", capacity = 50uL);
  let lane_ladder = well(label = "MolecularWeightLadderLane", carrier_id = "TB08SdsPageGel", carrier_position = "A6", capacity = 50uL);

  let separated_input_lane = RunInputSdsPageQcLane(input_sample = input_sample, lane = lane_input);
  let separated_flowthrough_lane = RunFlowthroughSdsPageQcLane(input_sample = flowthrough_sample, lane = lane_flowthrough);
  let separated_wash_lane = RunWashSdsPageQcLane(input_sample = wash_sample, lane = lane_wash);
  let separated_elution1_lane = RunElutionSdsPageQcLane(input_sample = elution1_sample, lane = lane_elution1);
  let separated_elution2_lane = RunElutionSdsPageQcLane(input_sample = elution2_sample, lane = lane_elution2);
  let separated_ladder_lane = RunSingleSdsPageMarkerLane(marker_sample = ladder_sample, lane = lane_ladder);

  let separated_lane_group = group([
    separated_input_lane,
    separated_flowthrough_lane,
    separated_wash_lane,
    separated_elution1_lane,
    separated_elution2_lane,
    separated_ladder_lane
  ]);

  return separated_lane_group;
}

protocol RecombinantProteinAffinityPurificationWithSdsPageQc returns (
  elution_fraction_1,
  elution_fraction_2,
  sds_page_qc_readout
) {
  // Part 1: Protein purification.
  // Source step S1: Start with a His-tagged bacterial expression pellet,
  // resuspend in cold native lysis/binding buffer, and mechanically lyse on ice
  // for 5 min.
  let expression_cell_pellet = tube(
    label = "HisTaggedExpressionCellPellet",
    capacity = 5mL,
    load = [
      content(kind = ContentKind.BIO_CELLULAR, type = ContentType.MICROBIAL_CELLS, code = "EXPRESSION_CELLS", attrs = { state: pellet, mass_basis: wet_weight, expression_product: "HIS_TAGGED_TARGET_PROTEIN", tag: his_tagged }):400mg,
      content(kind = ContentKind.BIO_MOLECULE_OR_VIRUS, type = ContentType.PROTEIN, code = "HIS_TAGGED_TARGET_PROTEIN", attrs = { role: expression_product, tag: his_tagged, accounting_basis: benchmark_declared }):1mg
    ]
  );
  let native_lysis_binding_buffer = tube(
    label = "NativeLysisBindingBuffer",
    capacity = 10mL,
    load = [content(kind = ContentKind.FORMULATION, type = ContentType.BUFFER, code = "NATIVE_LYSIS_BINDING_BUFFER", attrs = { role: lysis }):8mL]
  );
  let native_binding_buffer = tube(
    label = "NativeBindingBuffer",
    capacity = 10mL,
    load = [content(kind = ContentKind.FORMULATION, type = ContentType.BUFFER, code = "NATIVE_BINDING_BUFFER", attrs = { role: binding }):8mL]
  );
  let native_wash_buffer = tube(
    label = "NativeWashBuffer20To40mMImidazole",
    capacity = 10mL,
    load = [content(kind = ContentKind.FORMULATION, type = ContentType.BUFFER, code = "NATIVE_WASH_BUFFER", attrs = { role: wash, imidazole_mM: "20-40" }):8mL]
  );
  let native_elution_buffer = tube(
    label = "NativeElutionBuffer250To300mMImidazole",
    capacity = 5mL,
    load = [content(kind = ContentKind.FORMULATION, type = ContentType.BUFFER, code = "NATIVE_ELUTION_BUFFER", attrs = { role: elution, imidazole_mM: "250-300" }):4mL]
  );
  let liquid_waste = tube(label = "TB08LiquidWaste", capacity = 20mL);
  let disrupted_lysate = tube(label = "MechanicallyDisruptedLysate", capacity = 5mL);
  let clarified_lysate = tube(label = "ClarifiedLysate", capacity = 2mL);

  expression_cell_pellet << [native_lysis_binding_buffer:2mL];
  with env(thermal = 0C, duration = 5min) {
    let disruption_group = sep(
      sample = expression_cell_pellet,
      program = disrupt_program(duration = 5min),
      component_fates = {
        EXPRESSION_CELLS: { lysate: 0%, debris_or_residue: 100% },
        HIS_TAGGED_TARGET_PROTEIN: { lysate: 100%, debris_or_residue: 0% },
        NATIVE_LYSIS_BINDING_BUFFER: { lysate: 100%, debris_or_residue: 0% }
      },
      transitions = [
        transition(
          subject = expression_cell_pellet.materials[1],
          output = DisruptProgramOutput.LYSATE,
          to = MaterialRelation.FREE
        )
      ]
    );
    disrupted_lysate << [disruption_group[0]];
  }

  // Continued implementation for S1: clarify lysate at 12000 x g for 15 min at 4 C,
  // transfer clarified lysate without disturbing debris, and save input QC.
  with env(thermal = 4C, duration = 15min) {
    let clarification_group = sep(
      sample = disrupted_lysate,
      program = centrifuge_program(drive = 12000g),
      component_fates = {
        HIS_TAGGED_TARGET_PROTEIN: { supernatant: 100%, pellet: 0% },
        NATIVE_LYSIS_BINDING_BUFFER: { supernatant: 100%, pellet: 0% }
      }
    );
    clarified_lysate << [clarification_group[0]:1.62mL] with constraint(low_carryover);
  }

  let input_qc = tube(label = "InputQC", capacity = 200uL);
  input_qc << [clarified_lysate:20uL] with constraint(high_precision, low_carryover);

  // Source step S2: Equilibrate nickel resin in a gravity-flow column and
  // discard the equilibration flowthrough.
  let nickel_resin = tube(
    label = "NickelAffinityResin",
    capacity = 1mL,
    load = [content(kind = ContentKind.PARTICULATE, type = ContentType.RESIN, code = "NI_AFFINITY_RESIN", attrs = { role: affinity_purification }):800uL]
  );
  let affinity_column = chamber(label = "NickelAffinityGravityColumn", capacity = 5mL, open = true);
  affinity_column << [nickel_resin:400uL, native_binding_buffer:1mL];
  sep(
    sample = affinity_column,
    program = filtration_program(membrane = "nickel_resin_bed", drive = gravity),
    component_fates = {
      NI_AFFINITY_RESIN: { filtrate: 0%, retentate: 100% },
      NATIVE_BINDING_BUFFER: { filtrate: 100%, retentate: 0% }
    }
  );
  liquid_waste << [affinity_column.contents[0]];

  // Source step S3: Apply clarified lysate, bind at 4 C with gentle mixing,
  // drain by gravity, collect flowthrough, and save flowthrough QC.
  affinity_column << [clarified_lysate:1580uL];
  with constraint(gentle) {
    with env(thermal = 4C, duration = 30min) {
      hold(sample = affinity_column);
    }
  }
  sep(
    sample = affinity_column,
    program = filtration_program(membrane = "nickel_resin_bed", drive = gravity),
    component_fates = {
      NI_AFFINITY_RESIN: { filtrate: 0%, retentate: 100% },
      HIS_TAGGED_TARGET_PROTEIN: { filtrate: 0%, retentate: 100% },
      NATIVE_LYSIS_BINDING_BUFFER: { filtrate: 100%, retentate: 0% }
    }
  );
  let flowthrough_fraction = tube(label = "FlowthroughFraction", capacity = 2mL);
  flowthrough_fraction << [affinity_column.contents[0]];
  let flowthrough_qc = tube(label = "FlowthroughQC", capacity = 200uL);
  flowthrough_qc << [flowthrough_fraction:20uL] with constraint(high_precision, low_carryover);

  // Source step S4: Wash the bound resin three times with 1 mL wash buffer,
  // pool wash fractions, and save wash QC.
  let pooled_wash_fraction = tube(label = "PooledWashFraction", capacity = 5mL);
  affinity_column << [native_wash_buffer:1mL];
  sep(
    sample = affinity_column,
    program = filtration_program(membrane = "nickel_resin_bed", drive = gravity),
    component_fates = {
      NI_AFFINITY_RESIN: { filtrate: 0%, retentate: 100% },
      HIS_TAGGED_TARGET_PROTEIN: { filtrate: 0%, retentate: 100% },
      NATIVE_WASH_BUFFER: { filtrate: 100%, retentate: 0% }
    }
  );
  pooled_wash_fraction << [affinity_column.contents[0]];

  affinity_column << [native_wash_buffer:1mL];
  sep(
    sample = affinity_column,
    program = filtration_program(membrane = "nickel_resin_bed", drive = gravity),
    component_fates = {
      NI_AFFINITY_RESIN: { filtrate: 0%, retentate: 100% },
      HIS_TAGGED_TARGET_PROTEIN: { filtrate: 0%, retentate: 100% },
      NATIVE_WASH_BUFFER: { filtrate: 100%, retentate: 0% }
    }
  );
  pooled_wash_fraction << [affinity_column.contents[0]];

  affinity_column << [native_wash_buffer:1mL];
  sep(
    sample = affinity_column,
    program = filtration_program(membrane = "nickel_resin_bed", drive = gravity),
    component_fates = {
      NI_AFFINITY_RESIN: { filtrate: 0%, retentate: 100% },
      HIS_TAGGED_TARGET_PROTEIN: { filtrate: 0%, retentate: 100% },
      NATIVE_WASH_BUFFER: { filtrate: 100%, retentate: 0% }
    }
  );
  pooled_wash_fraction << [affinity_column.contents[0]];
  let wash_qc = tube(label = "WashQC", capacity = 200uL);
  wash_qc << [pooled_wash_fraction:20uL] with constraint(high_precision, low_carryover);

  // Source step S5: Elute twice with native imidazole elution buffer,
  // collecting separate fractions and QC aliquots.
  affinity_column << [native_elution_buffer:500uL];
  with env(thermal = 25C, duration = 5min) {
    hold(sample = affinity_column);
  }
  sep(
    sample = affinity_column,
    program = filtration_program(membrane = "nickel_resin_bed", drive = gravity),
    component_fates = {
      NI_AFFINITY_RESIN: { filtrate: 0%, retentate: 100% },
      HIS_TAGGED_TARGET_PROTEIN: { filtrate: 50%, retentate: 50% },
      NATIVE_ELUTION_BUFFER: { filtrate: 100%, retentate: 0% }
    }
  );
  let elution_fraction_1 = tube(
    label = "ElutionFraction1",
    capacity = 1mL,
    load = []
  );
  elution_fraction_1 << [affinity_column.contents[0]];
  let elution1_qc = tube(label = "Elution1QC", capacity = 200uL);
  elution1_qc << [elution_fraction_1:20uL] with constraint(high_precision, low_carryover);

  affinity_column << [native_elution_buffer:500uL];
  with env(thermal = 25C, duration = 5min) {
    hold(sample = affinity_column);
  }
  sep(
    sample = affinity_column,
    program = filtration_program(membrane = "nickel_resin_bed", drive = gravity),
    component_fates = {
      NI_AFFINITY_RESIN: { filtrate: 0%, retentate: 100% },
      HIS_TAGGED_TARGET_PROTEIN: { filtrate: 100%, retentate: 0% },
      NATIVE_ELUTION_BUFFER: { filtrate: 100%, retentate: 0% }
    }
  );
  let elution_fraction_2 = tube(
    label = "ElutionFraction2",
    capacity = 1mL,
    load = []
  );
  elution_fraction_2 << [affinity_column.contents[0]];
  let elution2_qc = tube(label = "Elution2QC", capacity = 200uL);
  elution2_qc << [elution_fraction_2:20uL] with constraint(high_precision, low_carryover);

  // Continued implementation for S5: keep collected fractions cold until SDS-PAGE QC.
  with env(thermal = 4C, duration = 30min) {
    hold(sample = group([flowthrough_fraction, pooled_wash_fraction, elution_fraction_1, elution_fraction_2]));
  }

  // Part 2: SDS-PAGE QC.
  // Source step S6: Prepare five QC samples with reducing SDS-PAGE loading
  // dye, heat at 95 C for 5 min, and briefly spin down.
  let reducing_loading_dye = tube(
    label = "ReducingSdsPageLoadingDye2x",
    capacity = 500uL,
    load = [content(kind = ContentKind.FORMULATION, type = ContentType.BUFFER, code = "REDUCING_SDS_PAGE_LOADING_DYE_2X", attrs = { role: reaction_environment }):400uL]
  );
  let molecular_weight_ladder = tube(
    label = "MolecularWeightLadder",
    capacity = 200uL,
    load = [content(kind = ContentKind.BIO_MOLECULE_OR_VIRUS, type = ContentType.PROTEIN, code = "MOLECULAR_WEIGHT_LADDER", attrs = { role: marker }):100uL]
  );
  let prepared_input_qc = tube(label = "PreparedInputQC", capacity = 100uL);
  let prepared_flowthrough_qc = tube(label = "PreparedFlowthroughQC", capacity = 100uL);
  let prepared_wash_qc = tube(label = "PreparedWashQC", capacity = 100uL);
  let prepared_elution1_qc = tube(label = "PreparedElution1QC", capacity = 100uL);
  let prepared_elution2_qc = tube(label = "PreparedElution2QC", capacity = 100uL);

  prepared_input_qc << [input_qc:15uL, reducing_loading_dye:15uL] with constraint(high_precision, low_carryover);
  prepared_flowthrough_qc << [flowthrough_qc:15uL, reducing_loading_dye:15uL] with constraint(high_precision, low_carryover);
  prepared_wash_qc << [wash_qc:15uL, reducing_loading_dye:15uL] with constraint(high_precision, low_carryover);
  prepared_elution1_qc << [elution1_qc:15uL, reducing_loading_dye:15uL] with constraint(high_precision, low_carryover);
  prepared_elution2_qc << [elution2_qc:15uL, reducing_loading_dye:15uL] with constraint(high_precision, low_carryover);

  // Source step S7: Heat and briefly centrifuge the prepared QC samples.
  with env(thermal = 95C, duration = 5min) {
    hold(sample = group([prepared_input_qc, prepared_flowthrough_qc, prepared_wash_qc, prepared_elution1_qc, prepared_elution2_qc]));
  }
  with env(thermal = 25C, duration = 5s) {
    sep(sample = prepared_input_qc, program = centrifuge_program(drive = 3000g));
    sep(sample = prepared_flowthrough_qc, program = centrifuge_program(drive = 3000g));
    sep(sample = prepared_wash_qc, program = centrifuge_program(drive = 3000g));
    sep(sample = prepared_elution1_qc, program = centrifuge_program(drive = 3000g));
    sep(sample = prepared_elution2_qc, program = centrifuge_program(drive = 3000g));
  }

  // Source step S8: Load QC samples and ladder into assigned SDS-PAGE lanes
  // and run the gel at 200 V for 45 min.
  let sds_page_gel = chamber(label = "TB08SdsPageGel", capacity = 600uL, open = true);
  let electrophoresis_tank = chamber(label = "TB08ElectrophoresisTank", capacity = 800mL);
  let running_buffer = container(
    label = "SdsPageRunningBufferBottle",
    capacity = 1L,
    load = [content(kind = ContentKind.FORMULATION, type = ContentType.BUFFER, code = "SDS_PAGE_RUNNING_BUFFER_1X", attrs = { role: reaction_environment }):800mL]
  );
  electrophoresis_tank << [running_buffer:800mL];
  let separated_lane_group = RunSdsPageLaneGroup(
    input_sample = prepared_input_qc,
    flowthrough_sample = prepared_flowthrough_qc,
    wash_sample = prepared_wash_qc,
    elution1_sample = prepared_elution1_qc,
    elution2_sample = prepared_elution2_qc,
    ladder_sample = molecular_weight_ladder
  );

  // Source step S9: remove, rinse, stain, destain, and image the gel.
  let water = container(
    label = "WaterBottle",
    capacity = 1L,
    load = [content(kind = ContentKind.FORMULATION, type = ContentType.BUFFER, code = "WATER", attrs = { role: rinse }):800mL]
  );
  let coomassie_stain = container(
    label = "CoomassieProteinStain",
    capacity = 500mL,
    load = [content(kind = ContentKind.CHEMICAL, type = ContentType.DYE, code = "COOMASSIE_STAIN", attrs = { role: stain }):400mL]
  );
  let stain_waste = container(label = "StainWaste", capacity = 1L);
  // PM #100 bridge: keep lane outputs distinct while they share one processing bath.
  let gel_processing_bath = chamber(label = "TB08GelProcessingBath", capacity = 100mL, open = true);

  gel_processing_bath << [water:20mL];
  sep(
    sample = gel_processing_bath,
    program = filtration_program(membrane = "polyacrylamide_gel", drive = "aspiration"),
    component_fates = {
      WATER: { filtrate: 100%, retentate: 0% }
    }
  );
  stain_waste << [gel_processing_bath.contents[0]];

  gel_processing_bath << [coomassie_stain:50mL];
  with constraint(gentle) {
    with env(thermal = 25C, duration = 1h) {
      hold(sample = separated_lane_group);
      hold(sample = gel_processing_bath);
    }
  }
  sep(
    sample = gel_processing_bath,
    program = filtration_program(membrane = "polyacrylamide_gel", drive = "aspiration"),
    component_fates = {
      COOMASSIE_STAIN: { filtrate: 95%, retentate: 5% }
    }
  );
  stain_waste << [gel_processing_bath.contents[0]];

  gel_processing_bath << [water:50mL];
  with constraint(gentle) {
    with env(thermal = 25C, duration = 30min) {
      hold(sample = separated_lane_group);
      hold(sample = gel_processing_bath);
    }
  }
  sep(
    sample = gel_processing_bath,
    program = filtration_program(membrane = "polyacrylamide_gel", drive = "aspiration"),
    component_fates = {
      COOMASSIE_STAIN: { filtrate: 95%, retentate: 5% },
      WATER: { filtrate: 100%, retentate: 0% }
    }
  );
  stain_waste << [gel_processing_bath.contents[0]];

  // Source step S10: Record lane identities, expected molecular weight,
  // band intensity, contaminant bands, and qualitative purity.
  let sds_page_qc_schema = data_schema(
    label = "TB08SdsPageQcReadout",
    fields = [
      lane_id,
      fraction_id,
      expected_target_molecular_weight,
      target_band_intensity,
      contaminant_bands,
      qualitative_purity
    ]
  );
  let sds_page_qc_readout = img(
    sample = separated_lane_group,
    quantity = customized,
    schema_ref = sds_page_qc_schema,
    save_raw = true
  );

  return
    elution_fraction_1 = elution_fraction_1,
    elution_fraction_2 = elution_fraction_2,
    sds_page_qc_readout = sds_page_qc_readout;
}

RecombinantProteinAffinityPurificationWithSdsPageQc();
