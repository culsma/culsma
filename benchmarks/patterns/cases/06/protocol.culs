  genotype_clone_b_allele_1_call = fixture_labels.result.fixture_wild_type_allele,
  genotype_clone_b_allele_2_call = fixture_labels.result.fixture_deleted_allele,
  genotype_clone_b_biallelic_deletion_confirmed = false,
  genotype_clone_b_heterozygous_deletion_confirmed = true,
  genotype_clone_b_qc_pass = true,
  protein_wt_gene_x_surface_status = fixture_labels.result.fixture_protein_positive,
  protein_wt_protein_negative = false,
  protein_wt_control_qc_pass = true,
  protein_nt_gene_x_surface_status = fixture_labels.result.fixture_protein_positive,
  protein_nt_protein_negative = false,
  protein_nt_control_qc_pass = true,
  protein_clone_a_gene_x_surface_status = fixture_labels.result.fixture_protein_negative,
  protein_clone_a_protein_negative = true,
