      "sample_masses_grams": {
        "sample_plate": 100
      },
      "counterweight": {
        "labware": "inert_balance_plate",
        "mass_grams": 100
      }
    }
  },
  "reference_environments": {
    "incubator": {
      "locations": [
        "C1"
      ],
      "labware_types": [
        "nest_96_wellplate_2ml_deep"
