protocol EnvReadoutProtocol {
    let reactor = tube(
        label = "Reactor",
        capacity = 100uL,
        load = [content(kind = formulation, type = buffer, code = "BUF02", attrs = { role: reaction_buffer }):20uL]
    );
    with env(thermal = 37C, duration = 10min) {
        hold(sample = reactor);
    }
    let obs = phy(sample = reactor, quantity = temperature);
}
