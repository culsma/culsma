protocol AntiCondensationThermalHold(
  target,
  sample_temperature,
  duration,
  top_temperature = 105C
) {
  with constraint(preserve_boundary) {
    with env(thermal = top_temperature, duration = duration) {
      hold(target.structure.top);

      with env(thermal = thermal_program(from = sample_temperature, duration = duration)) {
        hold(target);
      }
    }
  }

  return target;
}
